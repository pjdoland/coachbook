---
interface Props {
  title: string;
  description?: string;
  /**
   * Optional schema.org JSON-LD object to inject into <head>. Pages can
   * pass a Product (model bag), Person (designer), Article (history
   * event), or any other valid schema.org type. The site-level
   * WebSite + Organization JSON-LD is always emitted alongside.
   */
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const siteName = 'coachbook';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const base = import.meta.env.BASE_URL;

// Site-wide JSON-LD: identifies the archive as a structured WebSite
// with editorial metadata. Crawlers and downstream knowledge graphs
// can resolve "vintage Coach Leatherware archive" to a single entity.
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'coachbook',
  description: 'Independent reference archive of vintage Coach Leatherware, 1941–2002.',
  url: 'https://pjdoland.github.io/coachbook/',
  inLanguage: 'en',
  about: {
    '@type': 'Brand',
    name: 'Coach',
    description: 'Coach, Inc. — leather goods manufacturer founded 1941 in Manhattan.',
  },
  author: {
    '@type': 'Person',
    name: 'PJ Doland',
  },
  license: 'https://github.com/pjdoland/coachbook',
  isAccessibleForFree: true,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap"
    />
    {description && <meta name="description" content={description} />}
    <title>{fullTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <style is:global>
      /* ---------------------------------------------------------------------
       * coachbook visual language
       *
       * Subtle nod to Coach's 1981–1994 catalog editorial register without
       * literal logo or trademark mimicry: warm paper-toned background,
       * serif headings (Cormorant Garamond — old-style figures, generous
       * x-height; close in feel to the Garamonds Coach used in the
       * Cahn-era catalogs), sans-serif body for readability, restrained
       * brass accent for links, raw-edge dividers.
       *
       * Mobile-first. Most layout collapses to a single column under
       * 720px. Card-style sub-collection navigation on the index, tighter
       * dl rendering on model pages.
       * ------------------------------------------------------------------- */

      :root {
        /* Tell user agents the page is intentionally light-themed. Browsers
         * use this to pick the right form-control / scrollbar / autofill
         * defaults; without it, dark-mode users see paper-toned page chrome
         * mixed with dark form-control defaults. */
        color-scheme: light;
        /* Paper + ink — warm bone-tinted neutrals close to a 1980s Coach
         * catalog's matte paper stock. */
        --paper: #f5efe4;
        --paper-soft: #ede5d4;
        --paper-deeper: #e6dcc6;
        --ink: #1f1a14;
        --ink-soft: #4a4035;
        /* --ink-quiet darkened from #7a6f5e (3.7:1) to #635849 (~5.6:1)
         * to clear WCAG AA for body text at small sizes. Used on
         * card-meta, footer, footnotes, era-counts, back-to-top, and
         * wizard option `.sub` lines. */
        --ink-quiet: #635849;

        /* Brass accent — link color and section rules. Restrained;
         * approximates the warm yellow-brown of solid brass turnlock
         * hardware in artificial light. Not literal Coach-orange.
         * --brass darkened from #8a6a2b (4.4:1, fails AA body text)
         * to #7a5c22 (~5.4:1) to clear WCAG SC 1.4.3 — links count as
         * body text, not UI. */
        --brass: #7a5c22;
        --brass-deep: #5c4419;
        --brass-soft: #a88752;

        /* Bridle leather accent — used sparingly for state highlighting
         * (active wizard step, primary CTA). */
        --bridle: #6b3a1e;
        --bridle-soft: #8c5638;

        /* Surface elevations — for cards / wizard panels. */
        --surface: #fbf7ee;
        --surface-line: #d8ccae;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI',
          Roboto, sans-serif;
        font-size: 1rem;
        line-height: 1.6;
        color: var(--ink);
        background: var(--paper);
        max-width: 64ch;
        margin-inline: auto;
        padding: 1.25rem 1.25rem 4rem;
        font-feature-settings: 'kern' 1, 'liga' 1, 'clig' 1, 'onum' 1;
        font-variant-numeric: oldstyle-nums;
        font-variant-ligatures: common-ligatures contextual;
      }
      /* Tabular contexts override — anywhere we need digit columns to
       * align (year ranges in dl, history h3 dates, card-meta style
       * numbers, sticky era strip), the explicit tabular-nums rule
       * already applied at those nodes wins. lining-nums is added
       * here so figures sit on the baseline at heights consistent
       * with the surrounding lining-figure typography. */
      [data-tabular],
      .card-meta,
      .era-range,
      .strip-range {
        font-variant-numeric: tabular-nums lining-nums;
      }

      @media (min-width: 720px) {
        body {
          padding: 2.5rem 1.5rem 6rem;
          line-height: 1.65;
        }
      }

      /* Headings — serif, optical-style sizing. */
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
        font-weight: 500;
        line-height: 1.15;
        margin: 1.75em 0 0.5em;
        color: var(--ink);
        letter-spacing: 0.005em;
      }

      h1 {
        font-size: clamp(2rem, 6vw, 2.75rem);
        font-weight: 500;
        margin-top: 0.25em;
        margin-bottom: 0.4em;
      }

      h2 {
        font-size: clamp(1.4rem, 3.5vw, 1.75rem);
        margin-top: 2em;
      }

      h3 {
        font-size: clamp(1.15rem, 2.6vw, 1.35rem);
      }

      p, li, dd, dt {
        font-size: 1rem;
      }

      /* Body links — brass accent with thin underline that doesn't drown
       * paragraphs of citation links. */
      a {
        color: var(--brass);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.18em;
        /* Underline = currentColor so the only non-color affordance for
         * a link clears WCAG SC 1.4.11 (3:1 non-text contrast).
         * Previous --brass-soft was ~2.4:1 against paper. */
        text-decoration-color: currentColor;
        transition: color 120ms ease, text-decoration-color 120ms ease;
      }
      a:hover, a:focus-visible {
        color: var(--brass-deep);
      }

      /* Text selection in the brass family rather than the default
       * blue. Soft enough that a paragraph of selected source-cite
       * links remains readable. */
      ::selection {
        background: var(--brass-soft);
        color: var(--ink);
      }

      /* Source citation links: small, monospace, recessed but still
       * underlined for SC 1.4.1. The `[id]` brackets stay visible so
       * the citation reads the same as the source files do. */
      a.source-cite {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.85em;
        color: var(--ink-soft);
        text-decoration-color: var(--ink-quiet);
      }
      a.source-cite:hover, a.source-cite:focus-visible {
        color: var(--brass-deep);
        text-decoration-color: currentColor;
      }

      /* Inline model name links (auto-linked from narrative body text).
       * Read in line with the body — same color, lighter underline so a
       * paragraph thick with model mentions doesn't read as a forest of
       * brass. */
      a.model-link {
        color: var(--ink);
        text-decoration-color: var(--brass-soft);
        text-decoration-thickness: 1px;
      }
      a.model-link:hover, a.model-link:focus-visible {
        color: var(--brass-deep);
        text-decoration-color: currentColor;
      }

      /* Inline code + frontmatter style numbers — slightly recessed.
       * Scoped to NOT match <code> inside a <pre>, where shiki applies
       * its own dark-theme background and per-token colors. Without
       * the :not(pre) > guard the paper-soft background drowns
       * shiki's syntax highlighting. */
      :not(pre) > code {
        font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo,
          Consolas, monospace;
        font-size: 0.9em;
        background: var(--paper-soft);
        padding: 0.08em 0.35em;
        border-radius: 2px;
      }

      pre {
        padding: 1rem;
        border-radius: 4px;
        overflow-x: auto;
        font-size: 0.875rem;
      }
      /* shiki applies inline background-color on .astro-code; ensure the
       * inner <code> stays transparent so the per-token colors read. */
      pre code {
        background: transparent;
        padding: 0;
        font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo,
          Consolas, monospace;
        font-size: inherit;
      }

      blockquote {
        margin: 1.5em 0;
        padding: 0.75em 1.25em;
        border-left: 3px solid var(--brass);
        background: var(--paper-soft);
        font-style: italic;
        color: var(--ink-soft);
      }
      blockquote p:first-child { margin-top: 0; }
      blockquote p:last-child { margin-bottom: 0; }

      /* Tables — common in catalog roster sections. Compact, no
       * heavy borders, alternating warmth. */
      table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.92rem;
      }
      th, td {
        text-align: left;
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid var(--surface-line);
      }
      th {
        font-weight: 600;
        color: var(--ink-soft);
        background: var(--paper-soft);
      }
      tr:nth-child(even) td { background: rgba(232, 220, 195, 0.25); }

      /* Definition lists — used heavily on model spec pages.
       * grid-template-columns max-content 1fr keeps each dt/dd pair
       * row-locked even at 200% zoom (WCAG 1.4.10 Reflow). */
      dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        column-gap: 1rem;
        row-gap: 0.4rem;
        margin: 1.5rem 0;
        padding: 1rem 1.25rem;
        background: var(--surface);
        border-top: 1px solid var(--surface-line);
        border-bottom: 1px solid var(--surface-line);
        font-size: 0.95rem;
      }
      dt { grid-column: 1; }
      dd { grid-column: 2; }
      @media (max-width: 540px) {
        dl {
          grid-template-columns: 1fr;
          row-gap: 0.15rem;
        }
        dt, dd { grid-column: 1; }
        dt { margin-top: 0.5rem; }
        dt:first-child { margin-top: 0; }
      }
      dt {
        font-weight: 600;
        color: var(--ink-soft);
        font-variant-numeric: tabular-nums lining-nums;
      }
      dd {
        margin: 0;
        font-variant-numeric: tabular-nums lining-nums;
      }
      /* Year-heavy contexts get column-true digits for less jitter
       * across the 99-event timeline and the year-led card metas. */
      .card-meta,
      .history-body h3 {
        font-variant-numeric: tabular-nums lining-nums;
      }

      /* Lists — generous tap targets, no excessive bullet drift. */
      ul, ol {
        padding-left: 1.5em;
      }
      li + li { margin-top: 0.25em; }

      /* Layout regions ----------------------------------------------------- */

      header.site-header {
        margin: 0 -1.25rem 2rem;
        padding: 1rem 1.25rem 0.75rem;
        border-bottom: 1px solid var(--surface-line);
        display: flex;
        align-items: baseline;
        gap: 1rem;
      }
      @media (min-width: 720px) {
        header.site-header {
          margin: 0 0 3rem;
          padding: 0 0 1rem;
        }
      }

      header.site-header .brand {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        text-decoration: none;
        color: var(--ink);
      }
      header.site-header .brand:hover { color: var(--bridle); }
      header.site-header .tagline {
        font-size: 0.78rem;
        color: var(--ink-quiet);
        letter-spacing: 0.04em;
        font-style: italic;
      }
      @media (max-width: 540px) {
        /* On the narrowest screens the tagline is redundant with the
         * home-page standfirst; hide it so the brand + nav have room. */
        header.site-header .tagline { display: none; }
      }

      header.site-header nav {
        margin-left: auto;
        font-size: 0.85rem;
        display: flex;
        gap: 1rem;
      }
      header.site-header nav a {
        color: var(--ink-soft);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-decoration-color: transparent;
        text-underline-offset: 0.2em;
        transition: color 120ms ease, text-decoration-color 120ms ease;
      }
      header.site-header nav a:hover,
      header.site-header nav a:focus-visible {
        color: var(--brass-deep);
        text-decoration-color: currentColor;
      }

      footer.site-footer {
        margin: 5rem -1.25rem 0;
        padding: 1.5rem 1.25rem;
        border-top: 1px solid var(--surface-line);
        font-size: 0.85rem;
        color: var(--ink-quiet);
      }
      @media (min-width: 720px) {
        footer.site-footer {
          margin: 6rem 0 0;
          padding: 1.5rem 0;
        }
      }
      footer.site-footer p { margin: 0.4em 0; }

      main { display: block; }

      /* Card grid — used by index pages for sub-collections.
       * Grid items stretch to row height by default; the inner anchor
       * is set up as a column flex so the meta line sits at the bottom
       * regardless of label length. Result: cards in the same row are
       * equal-height. */
      .card-grid {
        display: grid;
        gap: 0.75rem;
        list-style: none;
        padding: 0;
        margin: 1.5rem 0;
      }
      @media (min-width: 540px) {
        .card-grid { grid-template-columns: repeat(2, 1fr); }
      }
      @media (min-width: 860px) {
        .card-grid { grid-template-columns: repeat(3, 1fr); }
      }
      .card-grid li {
        margin-top: 0;
        display: flex;
      }
      /* The HTML hidden attribute defaults to display: none, but the
       * card-grid li display: flex above is more specific and wins.
       * Re-assert hidden so client-side filters work. */
      .card-grid li[hidden] { display: none; }
      .card-grid a {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        width: 100%;
        padding: 0.95rem 1rem;
        background: var(--surface);
        border: 1px solid var(--surface-line);
        border-radius: 3px;
        text-decoration: none;
        color: var(--ink);
        transition: border-color 120ms ease, background 120ms ease;
      }
      .card-grid a:hover, .card-grid a:focus-visible {
        border-color: var(--brass);
        background: var(--paper-soft);
      }
      .card-grid a > strong {
        font-weight: 600;
        line-height: 1.3;
      }
      .card-grid .card-meta {
        display: block;
        margin-top: auto;
        font-size: 0.85rem;
        color: var(--ink-quiet);
        font-variant-numeric: tabular-nums lining-nums;
        padding-top: 0.25rem;
      }

      /* Confidence chips — small inline tags. */
      .chip {
        display: inline-block;
        padding: 0.05em 0.5em;
        font-size: 0.78rem;
        font-weight: 500;
        text-transform: lowercase;
        letter-spacing: 0.03em;
        border-radius: 999px;
        background: var(--paper-soft);
        color: var(--ink-soft);
        border: 1px solid var(--surface-line);
        vertical-align: 0.1em;
      }
      /* Border-style per confidence level so the chip taxonomy is
       * parseable without reading the label and without relying on
       * color (WCAG 1.4.1). solid = confirmed, dashed = likely,
       * dotted = tentative, double = disputed. */
      .chip[data-confidence='confirmed'] {
        background: rgba(138, 106, 43, 0.12);
        color: var(--brass-deep);
        border-color: var(--brass-soft);
        border-style: solid;
      }
      .chip[data-confidence='likely'] {
        background: rgba(138, 106, 43, 0.05);
        color: var(--ink-soft);
        border-color: var(--brass-soft);
        border-style: dashed;
      }
      .chip[data-confidence='tentative'] {
        border-style: dotted;
      }
      .chip[data-confidence='disputed'] {
        background: rgba(107, 58, 30, 0.08);
        color: var(--bridle);
        border-color: var(--bridle-soft);
        border-style: double;
        border-width: 3px;
        padding: 0 0.45em;
      }

      /* Print — strip nav, full-bleed paper. */
      @media print {
        body {
          background: white;
          color: black;
          max-width: none;
        }
        header.site-header nav, footer.site-footer { display: none; }
        a { color: black; text-decoration: none; }
      }

      /* Accessibility */
      :focus-visible {
        outline: 2px solid var(--brass);
        outline-offset: 2px;
        border-radius: 2px;
      }

      /* Skip link — positioned fixed to the viewport so it lands in the
       * actual top-left corner regardless of body's centered max-width.
       * Hidden via translate (not left:-9999px) so screen readers can
       * still announce it. WCAG SC 2.4.1. */
      .skip-link {
        position: fixed;
        top: 0.5rem;
        left: 0.5rem;
        z-index: 99;
        background: var(--ink);
        color: var(--paper);
        padding: 0.5rem 0.85rem;
        text-decoration: none;
        border-radius: 2px;
        transform: translateY(-150%);
        transition: transform 120ms ease;
      }
      .skip-link:focus {
        transform: translateY(0);
        outline: 2px solid var(--brass-soft);
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base}>coachbook</a>
      <span class="tagline">Vintage Coach reference, 1941–2002</span>
      <nav aria-label="Primary">
        <a href={`${base}models/`}>Models</a>
        <a href={`${base}authentication/`}>Authenticate</a>
        <a href={`${base}history/`}>History</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>An independent reference archive. Not affiliated with Coach, Inc.</p>
      <p>
        <a href={`${base}about/`}>About</a>
        ·
        <a href={`${base}errata/`}>Errata</a>
        ·
        <a href={`${base}disputes/`}>Disputes</a>
        ·
        <a href={`${base}sources/`}>Sources</a>
        ·
        <a href="https://github.com/pjdoland/coachbook/issues/new?title=Correction%3A%20"
           rel="noopener">Report a correction</a>
        ·
        <a href="https://github.com/pjdoland/coachbook">Source on GitHub</a>
      </p>
    </footer>
  </body>
</html>
