---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('authentication');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const label = entry.data.title ?? entry.data.name ?? entry.id;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={label}>
  <article>
    <h1>{label}</h1>
    <dl>
      {entry.data.era_coverage && (<><dt>Era coverage</dt><dd>{entry.data.era_coverage.join(', ')}</dd></>)}
      {entry.data.feature && (<><dt>Feature</dt><dd>{entry.data.feature}</dd></>)}
      {entry.data.confidence && (<><dt>Confidence</dt><dd><span class="chip" data-confidence={entry.data.confidence}>{entry.data.confidence}</span></dd></>)}
      {entry.data.status && (<><dt>Status</dt><dd>{entry.data.status}</dd></>)}
    </dl>
    <Content />

    <section class="back-to-flows">
      <p class="next-step">
        Authenticating a specific bag? Step through the
        <a href={`${base}wizard/`}>wizard</a> or compare against the
        <a href={`${base}authentication/decision-tree/`}>decision tree</a>.
        Browse all <a href={`${base}models/`}>models</a> for per-bag
        era and style references.
      </p>
    </section>

    {
      entry.data.sources && entry.data.sources.length > 0 && (
        <section>
          <h2>Sources</h2>
          <ul class="source-list">
            {entry.data.sources.map((id) => (
              <li>
                <a href={`${base}sources/#${id}`} class="source-cite">[{id}]</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .back-to-flows {
    margin-top: 2.5rem;
    padding: 1rem 1.25rem;
    background: var(--paper-soft);
    border-left: 3px solid var(--brass);
  }
  .back-to-flows .next-step {
    margin: 0;
    color: var(--ink-soft);
    max-width: 60ch;
  }
  .source-list {
    list-style: none;
    padding-left: 0;
  }
  .source-list li {
    margin: 0.2rem 0;
  }
</style>
