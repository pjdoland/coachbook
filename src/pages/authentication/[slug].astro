---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { summarize } from '../../lib/evidence.ts';

export async function getStaticPaths() {
  const entries = await getCollection('authentication');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const label = entry.data.title ?? entry.data.name ?? entry.id;
const base = import.meta.env.BASE_URL;
const evidence = summarize(entry.data.sources);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: label,
  about: 'Vintage Coach handbag authentication',
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'coachbook',
    url: 'https://pjdoland.github.io/coachbook/',
  },
  ...(entry.data.feature ? { keywords: entry.data.feature } : {}),
};
---

<BaseLayout title={label} jsonLd={jsonLd}>
  <article>
    <Breadcrumbs trail={[
      { label: 'Authentication', href: `${base}authentication/` },
      { label },
    ]} />
    <h1>{label}</h1>
    <dl>
      {entry.data.era_coverage && (<><dt>Era coverage</dt><dd>{entry.data.era_coverage.join(', ')}</dd></>)}
      {entry.data.feature && (<><dt>Feature</dt><dd>{entry.data.feature}</dd></>)}
      {entry.data.confidence && (<><dt>Confidence</dt><dd><span class="chip" data-confidence={entry.data.confidence}>{entry.data.confidence}</span></dd></>)}
      {entry.data.status && (<><dt>Status</dt><dd>{entry.data.status}</dd></>)}
    </dl>
    <Content />

    <section class="back-to-flows">
      <p class="next-step">
        Authenticating a specific bag? Step through the
        <a href={`${base}wizard/`}>wizard</a> or compare against the
        <a href={`${base}authentication/decision-tree/`}>decision tree</a>.
        Browse all <a href={`${base}models/`}>models</a> for per-bag
        era and style references.
      </p>
    </section>

    {
      entry.data.sources && entry.data.sources.length > 0 && (
        <section>
          <h2>Sources</h2>
          <p class="evidence-summary" data-tier={evidence.best ?? 'none'}>
            <strong>{evidence.label}.</strong> {evidence.total} {evidence.total === 1 ? 'source' : 'sources'} cited.
          </p>
          <ul class="source-list">
            {evidence.cited.map((c) => (
              <li>
                <a href={`${base}sources/#${c.id}`} class="source-cite">[{c.id}]</a>
                {c.tier && <span class="tier-pill" data-tier={c.tier}>Tier {c.tier}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .back-to-flows {
    margin-top: 2.5rem;
    padding: 1rem 1.25rem;
    background: var(--paper-soft);
    border-left: 3px solid var(--brass);
  }
  .back-to-flows .next-step {
    margin: 0;
    color: var(--ink-soft);
    max-width: 60ch;
  }
  .source-list { list-style: none; padding-left: 0; }
  .source-list li { margin: 0.25rem 0; display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; }
  .evidence-summary {
    margin: 0 0 0.85rem;
    padding: 0.7rem 0.95rem;
    background: var(--paper-soft);
    border-left: 3px solid var(--bridle);
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .evidence-summary[data-tier="1"] { border-left-color: var(--brass-deep); }
  .evidence-summary[data-tier="2"] { border-left-color: var(--brass); }
  .evidence-summary[data-tier="3"] { border-left-color: var(--bridle); }
  .evidence-summary[data-tier="4"] { border-left-color: var(--surface-line); }
  .tier-pill {
    display: inline-block;
    padding: 0.05rem 0.45rem;
    font-size: 0.72rem;
    font-family: 'Inter', sans-serif;
    letter-spacing: 0.04em;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-soft);
    border: 1px solid var(--surface-line);
    line-height: 1.5;
    white-space: nowrap;
  }
  .tier-pill[data-tier="1"] { background: var(--brass-deep); color: var(--paper); border-color: var(--brass-deep); }
  .tier-pill[data-tier="2"] { background: var(--brass); color: var(--paper); border-color: var(--brass); }
  .tier-pill[data-tier="3"] { background: var(--bridle-soft); color: var(--ink); border-color: var(--bridle-soft); }
  .tier-pill[data-tier="4"] { background: var(--paper); color: var(--ink-quiet); }
</style>
