---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = await getCollection('authentication');
const sorted = entries.sort((a, b) => {
  const al = (a.data.title ?? a.data.name ?? a.id).toString();
  const bl = (b.data.title ?? b.data.name ?? b.id).toString();
  return al.localeCompare(bl);
});
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Authentication">
  <h1>Authentication</h1>
  <p class="lede">
    No single check proves a bag authentic or fake. This is a
    topic-by-topic reference; combine multiple checks for any verdict.
  </p>

  <p class="cta-row">
    <a class="cta primary" href={`${base}wizard/`}>Start the wizard →</a>
    <a class="cta" href={`${base}authentication/decision-tree/`}>Printable decision tree</a>
  </p>

  <h2>All topics</h2>
  <ul class="card-grid">
    {sorted.map((entry) => (
      <li>
        <a href={`${base}authentication/${entry.id}/`}>
          <strong>{entry.data.title ?? entry.data.name ?? entry.id}</strong>
          {entry.data.confidence && (
            <span class="chip" data-confidence={entry.data.confidence}>
              {entry.data.confidence}
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .lede { font-size: 1.05rem; color: var(--ink-soft); margin-bottom: 1.5rem; max-width: 60ch; }
  .card-grid .chip { margin-top: 0.4rem; }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 2.5rem;
  }
  .cta {
    display: inline-block;
    padding: 0.6rem 1rem;
    border: 1px solid var(--surface-line);
    border-radius: 3px;
    text-decoration: none;
    color: var(--ink);
    background: var(--surface);
    font-weight: 500;
  }
  .cta:hover { border-color: var(--brass); background: var(--paper-soft); }
  .cta.primary {
    background: var(--bridle);
    color: var(--paper);
    border-color: var(--bridle);
  }
  .cta.primary:hover {
    background: var(--bridle-soft);
    border-color: var(--bridle-soft);
    color: var(--paper);
  }
</style>
