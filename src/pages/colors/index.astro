---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = await getCollection('colors');
const base = import.meta.env.BASE_URL;

const ERAS = [
  { code: 'E1', label: 'Pre-Cashin', range: '1941–1961' },
  { code: 'E2', label: 'Cashin', range: '1962–1974' },
  { code: 'E3', label: 'Early NYC', range: '1975–1984' },
  { code: 'E4', label: 'Late NYC', range: '1985–1994' },
  { code: 'E5', label: 'Krakoff transition', range: '1995–2002' },
];

// Many color entries span multiple eras (E3-E5 etc.). Each color goes
// into its earliest era bucket — when it was first introduced — and
// renders the full span as a meta. Falls back to deriving from era
// string when era_code isn't set.
function primaryEraCode(raw, code) {
  if (typeof code === 'string' && code.length > 0) {
    const m = code.match(/^E([1-5])/);
    if (m) return `E${m[1]}`;
  }
  if (!raw) return null;
  const s = String(raw).toLowerCase();
  if (s.includes('pre-cashin')) return 'E1';
  if (s.includes('cashin') && !s.includes('post-cashin')) return 'E2';
  if (s.includes('classic-nyc-late') || s.includes('late-nyc')) return 'E4';
  if (s.includes('classic-nyc') || s.includes('post-cashin') || s.includes('1970')) return 'E3';
  if (s.includes('krakoff') || s.includes('transition')) return 'E5';
  return null;
}

const sorted = entries.slice().sort((a, b) =>
  (a.data.name ?? a.data.title ?? a.id).localeCompare(
    b.data.name ?? b.data.title ?? b.id,
  ),
);
const buckets = new Map();
for (const era of ERAS) buckets.set(era.code, []);
const unsorted = [];
for (const entry of sorted) {
  const code = primaryEraCode(entry.data.era, entry.data.era_code);
  if (code) buckets.get(code).push(entry);
  else unsorted.push(entry);
}
---

<BaseLayout title="Colors" wide>
  <h1>Colors</h1>
  <p class="lede">
    Coach color names, with model coverage and authentication notes.
    Grouped by the era a color was first introduced. Color is rarely
    an era anchor on its own — combine with creed, serial, hardware,
    and country-of-origin.
  </p>

  {ERAS.map((era) => {
    const items = buckets.get(era.code);
    if (!items || items.length === 0) return null;
    return (
      <section class="era-section">
        <header class="era-heading">
          <h2>
            <span class="era-code">{era.code}</span>
            {era.label}
          </h2>
          <span class="era-range">{era.range}</span>
          <span class="era-count">{items.length}</span>
        </header>
        <ul class="card-grid">
          {items.map((entry) => (
            <li>
              <a href={`${base}colors/${entry.id}/`}>
                <strong>{entry.data.name ?? entry.data.title ?? entry.id}</strong>
                {(entry.data.era || entry.data.era_code) && (
                  <span class="card-meta">
                    {entry.data.era_code ?? entry.data.era}
                  </span>
                )}
                {entry.data.confidence && (
                  <span class="chip" data-confidence={entry.data.confidence}>
                    {entry.data.confidence}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    );
  })}

  {unsorted.length > 0 && (
    <section class="era-section">
      <header class="era-heading">
        <h2>Unsorted</h2>
        <span class="era-count">{unsorted.length}</span>
      </header>
      <ul class="card-grid">
        {unsorted.map((entry) => (
          <li>
            <a href={`${base}colors/${entry.id}/`}>
              <strong>{entry.data.name ?? entry.data.title ?? entry.id}</strong>
              {entry.data.confidence && (
                <span class="chip" data-confidence={entry.data.confidence}>
                  {entry.data.confidence}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .lede { font-size: 1.05rem; color: var(--ink-soft); margin-bottom: 1.5rem; max-width: 60ch; }
  .card-grid .chip { margin-top: 0.4rem; }
  .era-section { margin-top: 2.25rem; }
  .era-section:first-of-type { margin-top: 1rem; }
  .era-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.85rem;
    margin: 0 0 0.85rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--surface-line);
  }
  .era-heading h2 {
    margin: 0;
    font-size: 1.45rem;
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
  }
  .era-heading .era-code {
    display: inline-block;
    min-width: 1.6rem;
    padding: 0.05em 0.4em;
    background: var(--bridle);
    color: var(--paper);
    border-radius: 3px;
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    text-align: center;
    vertical-align: 0.2em;
  }
  .era-heading .era-range {
    font-size: 0.92rem;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .era-heading .era-count {
    font-size: 0.82rem;
    color: var(--ink-quiet);
    font-variant-numeric: tabular-nums lining-nums;
    margin-left: auto;
  }
</style>
