---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = await getCollection('colors');
const sorted = entries.sort((a, b) => {
  const al = (a.data.name ?? a.data.title ?? a.id).toString();
  const bl = (b.data.name ?? b.data.title ?? b.id).toString();
  return al.localeCompare(bl);
});
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Colors">
  <h1>Colors</h1>
  <p class="lede">
    Coach color names, with model coverage and authentication notes.
    Color is rarely an era anchor — combine with creed, serial,
    hardware, and country-of-origin.
  </p>
  <ul class="card-grid">
    {sorted.map((entry) => (
      <li>
        <a href={`${base}colors/${entry.id}/`}>
          <strong>{entry.data.name ?? entry.data.title ?? entry.id}</strong>
          {entry.data.confidence && (
            <span class="chip" data-confidence={entry.data.confidence}>
              {entry.data.confidence}
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .lede { font-size: 1.05rem; color: var(--ink-soft); margin-bottom: 1.5rem; max-width: 60ch; }
  .card-grid .chip { margin-top: 0.4rem; }
</style>
