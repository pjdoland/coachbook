---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { summarize } from '../../lib/evidence.ts';

export async function getStaticPaths() {
  const designers = await getCollection('designers');
  return designers.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const label = entry.data.name ?? entry.data.title ?? entry.id;
const base = import.meta.env.BASE_URL;

const tenureStart =
  entry.data.tenure_start ?? entry.data.coach_tenure_start;
const tenureEnd = entry.data.tenure_end ?? entry.data.coach_tenure_end;
const evidence = summarize(entry.data.sources);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: label,
  ...(entry.data.born ? { birthDate: String(entry.data.born) } : {}),
  ...(entry.data.died ? { deathDate: String(entry.data.died) } : {}),
  ...(entry.data.role ? { jobTitle: entry.data.role } : {}),
  ...(tenureStart || tenureEnd
    ? {
        worksFor: {
          '@type': 'Organization',
          name: 'Coach, Inc.',
          ...(tenureStart || tenureEnd
            ? { startDate: String(tenureStart ?? ''), endDate: String(tenureEnd ?? '') }
            : {}),
        },
      }
    : {}),
};
---

<BaseLayout title={label} jsonLd={jsonLd}>
  <article>
    <Breadcrumbs trail={[
      { label: 'Designers and people', href: `${base}designers/` },
      { label },
    ]} />
    <h1>{label}</h1>
    <dl>
      {entry.data.born && (<><dt>Born</dt><dd>{String(entry.data.born)}</dd></>)}
      {entry.data.died && (<><dt>Died</dt><dd>{String(entry.data.died)}</dd></>)}
      {(tenureStart || tenureEnd) && (
        <>
          <dt>Coach tenure</dt>
          <dd>{tenureStart ?? '?'}–{tenureEnd ?? '?'}</dd>
        </>
      )}
      {entry.data.employment_status && (
        <><dt>Employment status</dt><dd>{entry.data.employment_status}</dd></>
      )}
      {entry.data.confidence && (
        <><dt>Confidence</dt><dd><span class="chip" data-confidence={entry.data.confidence}>{entry.data.confidence}</span></dd></>
      )}
    </dl>
    <Content />
    {
      entry.data.sources && entry.data.sources.length > 0 && (
        <section>
          <h2>Sources</h2>
          <p class="evidence-summary" data-tier={evidence.best ?? 'none'}>
            <strong>{evidence.label}.</strong> {evidence.total} {evidence.total === 1 ? 'source' : 'sources'} cited.
          </p>
          <ul class="source-list">
            {evidence.cited.map((c) => (
              <li>
                <a href={`${base}sources/#${c.id}`} class="source-cite">[{c.id}]</a>
                {c.tier && <span class="tier-pill" data-tier={c.tier}>Tier {c.tier}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .source-list { list-style: none; padding-left: 0; }
  .source-list li { margin: 0.25rem 0; display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; }
  .evidence-summary {
    margin: 0 0 0.85rem;
    padding: 0.7rem 0.95rem;
    background: var(--paper-soft);
    border-left: 3px solid var(--bridle);
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .evidence-summary[data-tier="1"] { border-left-color: var(--brass-deep); }
  .evidence-summary[data-tier="2"] { border-left-color: var(--brass); }
  .evidence-summary[data-tier="3"] { border-left-color: var(--bridle); }
  .evidence-summary[data-tier="4"] { border-left-color: var(--surface-line); }
  .tier-pill {
    display: inline-block;
    padding: 0.05rem 0.45rem;
    font-size: 0.72rem;
    font-family: 'Inter', sans-serif;
    letter-spacing: 0.04em;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-soft);
    border: 1px solid var(--surface-line);
    line-height: 1.5;
    white-space: nowrap;
  }
  .tier-pill[data-tier="1"] { background: var(--brass-deep); color: var(--paper); border-color: var(--brass-deep); }
  .tier-pill[data-tier="2"] { background: var(--brass); color: var(--paper); border-color: var(--brass); }
  .tier-pill[data-tier="3"] { background: var(--bridle-soft); color: var(--ink); border-color: var(--bridle-soft); }
  .tier-pill[data-tier="4"] { background: var(--paper); color: var(--ink-quiet); }
</style>
