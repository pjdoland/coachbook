---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Authentication wizard"
  description="Step-through authentication flow for vintage Coach bags. 5–7 questions, era-consistency checking, source-cited verdict."
>
  <h1>Authentication wizard</h1>
  <p class="lede">
    Walk through the questions one at a time. This is a navigation
    tool, not a final verdict — every answer is cross-checked against
    era consistency, and the result links back to the underlying topics.
  </p>

  <noscript>
    <div class="noscript-warn">
      <p>
        The wizard needs JavaScript. If you can't run it, the
        <a href={`${base}authentication/decision-tree/`}>printable decision tree</a>
        covers the same flow on a single page.
      </p>
    </div>
  </noscript>

  <div id="wizard" data-base={base} hidden role="region" aria-live="polite" aria-atomic="false"></div>

  <p class="footnote">
    Based on
    <a href={`${base}authentication/decision-tree/`}>the printable decision tree</a>.
    No single check is sufficient — era-consistent answers across
    creed, country, serial, hardware, and construction are required
    before a bag can be called authentic.
  </p>
</BaseLayout>

<style is:global>
  /* Wizard styles must be is:global because the wizard's JS creates
   * its DOM dynamically — Astro's scoped-style data attribute is NOT
   * applied to nodes created by `document.createElement` after page
   * load. With scoped styles, .wiz-options et al simply do not match. */

  .lede { font-size: 1.05rem; color: var(--ink-soft); margin-bottom: 1.5rem; max-width: 60ch; }
  .footnote { font-size: 0.88rem; color: var(--ink-quiet); margin-top: 3rem; }

  .noscript-warn {
    padding: 1rem;
    background: var(--paper-soft);
    border-left: 3px solid var(--bridle);
    margin: 1.5rem 0;
  }

  /* Wizard chrome ------------------------------------------------------ */
  #wizard {
    margin: 2rem 0;
    background: var(--surface);
    border: 1px solid var(--surface-line);
    border-radius: 4px;
    overflow: hidden;
  }

  .wiz-progress {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--paper-soft);
    border-bottom: 1px solid var(--surface-line);
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  /* Stepped indicator — discrete pips give spatial memory of where the
   * user is in the flow. Completed = brass, current = bridle, remaining
   * = surface-line. */
  .wiz-progress .pip-row {
    flex: 1;
    display: flex;
    gap: 0.25rem;
  }
  .wiz-progress .pip-step {
    flex: 1;
    height: 4px;
    background: var(--surface-line);
    border-radius: 2px;
  }
  .wiz-progress .pip-step.is-done { background: var(--brass); }
  .wiz-progress .pip-step.is-current { background: var(--bridle); }

  .wiz-step {
    padding: 1.5rem 1.25rem 1.75rem;
  }
  @media (min-width: 720px) {
    .wiz-step { padding: 2rem 1.75rem 2rem; }
  }

  /* Override global h2 spacing — no leading margin inside the wizard,
   * the progress bar is the section start. */
  .wiz-step h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }
  .wiz-step .step-hint {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin: 0 0 1.25rem;
    line-height: 1.5;
  }

  /* Override global ul margins / list-style for the options grid. */
  ul.wiz-options {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  ul.wiz-options li {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul.wiz-options button {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.85rem 1rem;
    background: var(--paper);
    border: 1px solid var(--surface-line);
    border-radius: 3px;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink);
    transition: border-color 120ms ease, background 120ms ease;
  }
  ul.wiz-options button:hover {
    border-color: var(--brass);
    background: var(--paper-soft);
  }
  /* Stronger focus-visible — outline + box-shadow ring so keyboard
   * users get an unambiguous indicator separate from hover styling. */
  ul.wiz-options button:focus-visible {
    border-color: var(--brass);
    background: var(--paper-soft);
    outline: 2px solid var(--brass);
    outline-offset: 3px;
    box-shadow: 0 0 0 1px var(--paper) inset;
  }
  ul.wiz-options button strong {
    display: block;
    margin: 0 0 0.2rem;
    font-weight: 600;
  }
  ul.wiz-options button .sub {
    display: block;
    font-size: 0.85rem;
    color: var(--ink-quiet);
    line-height: 1.4;
  }

  .wiz-controls {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--surface-line);
    background: var(--paper-soft);
    flex-wrap: wrap;
  }
  .wiz-controls button {
    /* 44×44 minimum touch target per WCAG 2.5.8. */
    min-height: 44px;
    padding: 0.5rem 1rem;
    background: var(--surface);
    border: 1px solid var(--surface-line);
    border-radius: 3px;
    font-family: inherit;
    font-size: 0.92rem;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 120ms ease, background 120ms ease;
  }
  .wiz-controls button:hover:not([disabled]) {
    border-color: var(--brass);
    background: var(--paper);
  }
  .wiz-controls button[disabled] {
    /* Keep the disabled state perceivable: explicit color (instead of
     * opacity) preserves text contrast for low-vision users; aria-disabled
     * + native disabled both convey state to AT. */
    color: var(--ink-quiet);
    background: var(--paper-soft);
    border-style: dashed;
    cursor: not-allowed;
  }

  /* Trail / running summary — sits above the step body now so users
   * can see previous answers without scrolling past the question. */
  .wiz-trail {
    padding: 0.85rem 1.25rem 1rem;
    border-bottom: 1px solid var(--surface-line);
    font-size: 0.85rem;
    color: var(--ink-soft);
    background: var(--paper-soft);
  }
  .wiz-trail .trail-heading {
    margin: 0 0 0.4rem;
    font-weight: 600;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.78rem;
  }
  details.wiz-trail summary { cursor: pointer; }
  details.wiz-trail .wiz-trail-list { margin-top: 0.4rem; }
  details.wiz-trail:not([open]) .wiz-trail-list { display: none; }
  ol.wiz-trail-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }
  ol.wiz-trail-list li {
    display: grid;
    grid-template-columns: 4.5em 1fr;
    gap: 0.5em;
    margin: 0;
  }
  ol.wiz-trail-list .step-num {
    color: var(--ink-soft);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  ol.wiz-trail-list .step-answer {
    color: var(--ink);
  }

  /* Verdict ----------------------------------------------------------- */
  .wiz-verdict {
    padding: 1.5rem 1rem;
  }
  .wiz-verdict .verdict-heading {
    /* Visually-hidden — the verdict-tag chip below carries the same
     * label visually. The h2 is here for AT focus + announcement and
     * for the role=status live region. */
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (min-width: 720px) {
    .wiz-verdict { padding: 2rem 1.75rem; }
  }
  .wiz-verdict .verdict-tag {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.2rem;
    font-weight: 500;
    border-radius: 3px;
    margin-bottom: 0.75rem;
  }
  .wiz-verdict .verdict-tag[data-verdict='likely-authentic'] {
    background: rgba(138, 106, 43, 0.12);
    color: var(--brass-deep);
    border: 1px solid var(--brass);
  }
  .wiz-verdict .verdict-tag[data-verdict='caveats'] {
    background: var(--paper-soft);
    color: var(--ink-soft);
    border: 1px solid var(--surface-line);
  }
  .wiz-verdict .verdict-tag[data-verdict='red-flags'] {
    background: rgba(107, 58, 30, 0.1);
    color: var(--bridle);
    border: 1px solid var(--bridle-soft);
  }
  .wiz-verdict .verdict-tag[data-verdict='no-creed'] {
    background: var(--paper-soft);
    color: var(--ink-soft);
    border: 1px solid var(--surface-line);
  }
  .wiz-verdict h3 {
    font-size: 1.05rem;
    margin: 1.5em 0 0.4em;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
  }
  .wiz-verdict ul { padding-left: 1.25em; }
  .wiz-verdict .next-reads {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .wiz-verdict .next-reads a {
    display: block;
    padding: 0.6rem 0.85rem;
    background: var(--paper-soft);
    border: 1px solid var(--surface-line);
    border-radius: 3px;
    text-decoration: none;
    color: var(--ink);
  }
  .wiz-verdict .next-reads a:hover { border-color: var(--brass); }
  .wiz-verdict .next-reads a strong { display: block; }
  .wiz-verdict .next-reads a .sub { font-size: 0.85rem; color: var(--ink-quiet); }
</style>

<script is:inline define:vars={{ wizardBase: import.meta.env.BASE_URL }}>
  /* Authentication wizard — pure client-side state machine.
   * Steps mirror authentication/decision-tree.md. Each option
   * carries optional era hints (e2a/e2b/e3/e4/e5/transitional)
   * and red_flag deltas. Verdict is computed from accumulated
   * era hints + flags. */

  const STEPS = {
    'creed': {
      n: 2, of: 6,
      title: 'Is there a leather creed patch?',
      hint: 'The creed is the leather rectangle inside the bag with "COACH" wording and (usually) a serial number.',
      options: [
        {
          label: 'No creed, but a small metal interior tag',
          sub: 'A metal plaque rather than a leather patch',
          era: ['e2a'],
          next: 'verdict-no-creed',
        },
        {
          label: 'No creed, no metal tag — just an inked leather stamp inside',
          sub: 'No patch, no plaque; brand stamped directly on lining or seam',
          era: ['e2b'],
          next: 'verdict-no-creed',
        },
        {
          label: 'Yes — a leather creed with a serial number',
          sub: 'The standard rectangular patch with brand wording and digits',
          next: 'wordmark',
        },
        {
          label: "There's a creed but no serial",
          sub: 'Pre-1980 bags, small accessories, and some 1990s pebbled-leather models legitimately shipped without serials',
          flags: 0,
          next: 'wordmark',
        },
      ],
    },

    'wordmark': {
      n: 3, of: 6,
      title: 'What does the creed say?',
      hint: 'Look for the second word stamped beneath "COACH" on the creed.',
      options: [
        {
          label: '"COACH" with small-caps "LEATHERWARE" beneath',
          sub: 'Pre-1994 — E3 or E4 era',
          era: ['e3', 'e4'],
          next: 'country',
        },
        {
          label: 'Just "COACH" — no LEATHERWARE',
          sub: '1994 or later — E5 or modern',
          era: ['e5'],
          next: 'country',
        },
        {
          label: "I can't tell — the creed is too worn to read",
          sub: 'No era hint recorded; verdict relies on the other dimensions.',
          next: 'country',
        },
      ],
    },

    'country': {
      n: 4, of: 6,
      title: 'What does the country-of-origin marking say?',
      hint: 'Usually stamped on the creed below the brand wording.',
      options: [
        { label: '"Made in New York City, U.S.A."', sub: '1970s through ~1980 (early E3); should pair with LEATHERWARE', era: ['e3'], next: 'serial' },
        { label: '"Made in United States" / "Made in U.S.A."', sub: '1980 through 1994 (late E3 into E4); should pair with LEATHERWARE', era: ['e3', 'e4'], next: 'serial' },
        { label: '"Made in Costa Rica" / "Hungary" / "Turkey" / "Dominican Republic" / "Mexico"', sub: '1994 through early 2000s (E5); should pair with LEATHERWARE-absent creed', era: ['e5'], next: 'serial' },
        { label: '"Made in Italy"', sub: 'Exotic-skin or Madison/Gramercy line; line-specific, not era-specific', era: ['line-specific'], next: 'serial' },
        { label: '"Made in Puerto Rico, U.S.A."', sub: 'Through April 2002 (Lares facility, last in-house plant)', era: ['e5'], next: 'serial' },
        { label: '"Handcrafted in China"', sub: '2000s onward — post-vintage for this archive', era: ['post-vintage'], next: 'serial' },
        { label: 'No country marking visible', sub: 'Pre-late-1970s common; era-context dependent', flags: 0, next: 'serial' },
        { label: "I can't tell — the stamp is illegible", sub: 'No era hint recorded.', next: 'serial' },
      ],
    },

    'serial': {
      n: 5, of: 6,
      title: 'What is the serial format?',
      hint: 'Below the brand and country wording on the creed.',
      options: [
        { label: 'All digits: "xxx-xxxx" or "xxxx-xxx"', sub: 'Pre-1994. Should pair with LEATHERWARE wording and US origin.', era: ['e3', 'e4'], next: 'construction' },
        { label: 'Letter-digit-letter, e.g. "B6D-9927"', sub: '1994 onward. Single-digit-year ambiguity (1996 vs 2006) — never publish a year from the code alone.', era: ['e5'], next: 'construction' },
        { label: 'Two-digit year, e.g. "B16D-9927"', sub: '2004 onward — post-vintage for this archive.', era: ['post-vintage'], next: 'construction' },
        { label: 'No serial', sub: 'Era-context dependent. Pre-1980 bags and small accessories shipped without serials. Absence is not by itself a fake tell.', flags: 0, next: 'construction' },
        { label: "I can't read the serial — it's too worn", sub: 'No era hint recorded; common on heavily-used vintage examples.', next: 'construction' },
      ],
    },

    'hardware': {
      n: 1, of: 6,
      title: 'Does the hardware pass the magnet test?',
      hint: 'Hold a refrigerator magnet to the turnlock face, the dogleash clip, and any visible D-rings. Fastest single-check triage on the page — the rest of the questions help calibrate your reading.',
      options: [
        { label: 'Magnet does not stick to any of the brass-looking hardware', sub: 'Solid brass — era-correct for pre-2000 vintage Coach', flags: 0, next: 'creed' },
        { label: 'Magnet sticks', sub: 'Plated steel — likely fake or post-vintage replacement hardware', flags: 2, next: 'creed' },
        { label: 'Mixed — some pieces stick, some don\'t', sub: 'Possible replacement component (Coach Repair) or partial fake. One red flag for now.', flags: 1, next: 'creed' },
        { label: 'Hardware looks lighter or shows silver-grey under wear', sub: 'Plated, not solid brass. Strong fake tell.', flags: 2, next: 'creed' },
        { label: 'Hardware is nickel/silver-finished by design', sub: 'Krakoff-era 1998+ Coach Neo, music-named Classics, and Krakoff-era sub-collections shipped with nickel hardware. Era-correct for E5.', era: ['e5'], next: 'creed' },
      ],
    },

    'construction': {
      n: 6, of: 6,
      title: 'What does the construction tell you?',
      hint: 'Edge treatment, smell, lining material — multiple checks combined.',
      options: [
        { label: 'Raw or burnished edges; leather-and-neatsfoot smell; era-correct lining', sub: 'Era-consistent with vintage Coach construction', flags: 0, next: 'verdict' },
        { label: 'Glossy painted edges on a bag claiming pre-1995 manufacture', sub: 'Strong fake tell — vintage Coach edges are raw or burnished', flags: 2, next: 'verdict' },
        { label: 'Acetone, plastic, or chemical-solvent smell', sub: 'Fake signal — glove-tanned leather has a distinct neatsfoot odor', flags: 2, next: 'verdict' },
        { label: 'Heat-cut polyester pockets on a pre-1995 bag', sub: 'Fake tell — early Coach NYC-era bags use raw-suede or unlined interiors', flags: 1, next: 'verdict' },
        { label: 'Zipper maker mismatched to creed era (e.g., YKK on a 1960s creed, Talon on an E5 offshore creed)', sub: 'Possible replacement zipper or fake. One flag in isolation; more if other dimensions disagree.', flags: 1, next: 'verdict' },
        { label: "Construction looks correct — I can't see a red flag here", sub: 'No flag added. Combined with era-consistency, points to authentic.', flags: 0, next: 'verdict' },
      ],
    },
  };

  /* ---------- state ---------- */
  const wiz = document.getElementById('wizard');
  const state = {
    history: [], // [{stepId, optionIndex, label, era, flags}]
    current: 'hardware',
  };

  /* ---------- era-consistency check ---------- */
  function isInconsistent() {
    const eras = state.history
      .flatMap(h => h.era || [])
      .filter(e => !['line-specific', 'post-vintage'].includes(e));
    if (eras.length < 2) return false;

    // Allow E3 + E4 to coexist. Anything else mixed is inconsistent.
    const hasPre = eras.some(e => ['e2a', 'e2b', 'e3', 'e4'].includes(e));
    const hasPost = eras.some(e => e === 'e5');
    return hasPre && hasPost;
  }

  function totalFlags() {
    return state.history.reduce((sum, h) => sum + (h.flags || 0), 0);
  }

  /* ---------- rendering ---------- */
  function render() {
    if (state.current.startsWith('verdict')) {
      renderVerdict();
      return;
    }
    const step = STEPS[state.current];
    if (!step) return;

    wiz.innerHTML = '';

    // progress — stepped indicator with one pip per step
    const prog = document.createElement('div');
    prog.className = 'wiz-progress';
    const pips = Array.from({ length: step.of }, (_, i) => {
      const n = i + 1;
      const cls = n < step.n ? 'pip-step is-done'
                : n === step.n ? 'pip-step is-current'
                : 'pip-step';
      return `<span class="${cls}" aria-hidden="true"></span>`;
    }).join('');
    prog.innerHTML = `
      <span>Step ${step.n} of ${step.of}</span>
      <span class="pip-row" role="progressbar"
            aria-valuemin="1" aria-valuemax="${step.of}" aria-valuenow="${step.n}">
        ${pips}
      </span>
    `;
    wiz.appendChild(prog);

    // step body
    const body = document.createElement('div');
    body.className = 'wiz-step';
    const h = document.createElement('h2');
    h.textContent = step.title;
    /* tabindex=-1 so we can move focus to the new heading on each
     * step change. AT users will hear the new question announced
     * naturally; sighted keyboard users see the focus jump up to the
     * top of the step instead of staying on the no-longer-visible
     * previous button. WCAG SC 2.4.3 + 4.1.3. */
    h.setAttribute('tabindex', '-1');
    h.id = `wiz-step-${state.current}`;
    const hint = document.createElement('p');
    hint.className = 'step-hint';
    hint.textContent = step.hint;
    const ul = document.createElement('ul');
    ul.className = 'wiz-options';
    /* role=group + aria-labelledby ties the option list to the step
     * heading so AT announces "1 of N" position context for each
     * button. WCAG SC 1.3.1 + 4.1.2. */
    ul.setAttribute('role', 'group');
    ul.setAttribute('aria-labelledby', h.id);
    step.options.forEach((opt, i) => {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('aria-posinset', String(i + 1));
      btn.setAttribute('aria-setsize', String(step.options.length));
      btn.innerHTML = `<strong>${opt.label}</strong>${opt.sub ? `<span class="sub">${opt.sub}</span>` : ''}`;
      btn.addEventListener('click', () => choose(i));
      li.appendChild(btn);
      ul.appendChild(li);
    });
    body.appendChild(h);
    body.appendChild(hint);
    body.appendChild(ul);

    /* Render order: progress → trail (collapsed) → body → controls.
     * Trail above body so users see their previous answers without
     * scrolling past the question on mobile. */
    renderTrail();
    wiz.appendChild(body);
    renderControls();

    /* Move focus to the new heading after the DOM is in place so AT
     * announces the step change instead of staying on the now-detached
     * previous button. */
    if (state.history.length > 0) h.focus();
  }

  function renderControls() {
    const ctl = document.createElement('div');
    ctl.className = 'wiz-controls';
    const back = document.createElement('button');
    back.type = 'button';
    back.textContent = '← Back';
    back.disabled = state.history.length === 0;
    back.addEventListener('click', goBack);
    const restart = document.createElement('button');
    restart.type = 'button';
    restart.textContent = 'Start over';
    restart.addEventListener('click', restartWizard);
    ctl.appendChild(back);
    ctl.appendChild(restart);
    wiz.appendChild(ctl);
  }

  function renderTrail() {
    if (state.history.length === 0) return;
    /* After step 2, collapse the trail by default — once the list grows
     * past two answers, an open list crowds the question above the
     * fold on mobile. The summary still shows the count so users know
     * to expand if they want to review. */
    const useDetails = state.history.length > 2;
    const trail = document.createElement(useDetails ? 'details' : 'div');
    trail.className = 'wiz-trail';
    if (useDetails) {
      const summary = document.createElement('summary');
      summary.className = 'trail-heading';
      summary.textContent = `Your answers so far (${state.history.length})`;
      trail.appendChild(summary);
    } else {
      const heading = document.createElement('p');
      heading.className = 'trail-heading';
      heading.textContent = 'Your answers so far';
      trail.appendChild(heading);
    }
    const ol = document.createElement('ol');
    ol.className = 'wiz-trail-list';
    state.history.forEach((h, i) => {
      const li = document.createElement('li');
      li.innerHTML = `<span class="step-num">Step ${i + 1}</span><span class="step-answer">${h.label}</span>`;
      ol.appendChild(li);
    });
    trail.appendChild(ol);
    wiz.appendChild(trail);
  }

  function choose(i) {
    const step = STEPS[state.current];
    const opt = step.options[i];
    state.history.push({
      stepId: state.current,
      optionIndex: i,
      label: opt.label,
      era: opt.era || [],
      flags: opt.flags ?? 0,
    });
    state.current = opt.next;
    render();
    // smooth scroll to top of wizard for mobile
    /* Honor prefers-reduced-motion (WCAG SC 2.3.3): users who request
     * reduced motion get an instant jump rather than a smooth scroll. */
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    wiz.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
  }

  function goBack() {
    if (state.history.length === 0) return;
    const last = state.history.pop();
    state.current = last.stepId;
    render();
  }

  function restartWizard() {
    state.history = [];
    state.current = 'creed';
    render();
  }

  /* ---------- verdict ---------- */
  function renderVerdict() {
    wiz.innerHTML = '';

    const flags = totalFlags();
    const inconsistent = isInconsistent();
    const noCreed = state.current === 'verdict-no-creed';

    let verdict, verdictLabel, summary, body;

    if (noCreed) {
      verdict = 'no-creed';
      verdictLabel = 'Cashin-era pattern (no creed)';
      summary = 'Bags without a creed are typically Cashin-era (1962–early 1970s). The creed-based steps below do not apply — authentication relies on hardware, leather, and construction tells.';
      body = [
        'Begin with the magnet test on hardware (Step 5 in the printable tree).',
        'Examine leather edges (raw or burnished only — never painted glossy on a Cashin-era bag).',
        'Look for hand-stitched seams, brass turnlocks (post-1964 only), and cowhide-and-neatsfoot smell.',
        'When in doubt, post the canonical photo set to PurseForum\'s "Authenticate This COACH" thread.',
      ];
    } else if (inconsistent) {
      verdict = 'red-flags';
      verdictLabel = 'The eras don\'t line up';
      summary = 'Your answers describe combinations that should not coexist on an authentic vintage Coach bag (for example: pre-1994 LEATHERWARE wording with offshore country marking, or 1970s "New York City" stamp with a 1994+ letter-digit-letter serial).';
      body = [
        'Most likely a fake or replacement creed. See country-of-origin §"Era-inconsistency = fake."',
        'Less likely but possible: legitimate Coach Repair work (Jacksonville FL from July 1999 onward) replaced creeds during restoration. The replacement explanation only covers one mismatch — not multiple.',
        'Treat the bag as suspect until you can resolve the era contradiction. Photograph everything and post to a community thread.',
      ];
    } else if (flags >= 2) {
      verdict = 'red-flags';
      verdictLabel = '2+ red flags';
      summary = 'Two or more red flags in independent dimensions. This is a fake or Frankenbag pattern.';
      body = [
        'Do not buy without significant additional verification.',
        'A single red flag in isolation can be a replacement component (Coach Repair). Two flags in independent dimensions cannot.',
        'Photograph the bag fully and post to PurseForum\'s "Authenticate This COACH" thread for a second opinion.',
      ];
    } else if (flags === 1) {
      verdict = 'caveats';
      verdictLabel = 'One red flag — possibly a replacement component';
      summary = 'A single red flag in one dimension is consistent with a replacement component (Coach Repair work) on an otherwise authentic bag — not by itself a fake tell.';
      body = [
        'Re-check the dimensions you didn\'t flag. Era-consistent results across creed, country, serial, hardware, and construction are needed before calling the bag authentic.',
        'If a second flag appears on a closer look, the replacement explanation no longer covers it.',
        'Coach Repair (Jacksonville FL from July 1999) replaced creeds, hardware, hangtags, and zippers during legitimate restoration through the program\'s lifetime.',
      ];
    } else {
      verdict = 'likely-authentic';
      verdictLabel = 'Likely authentic';
      summary = 'No red flags surfaced and your answers are era-consistent across creed, country, serial, hardware, and construction. This is the strongest pattern an authentication walkthrough can produce.';
      body = [
        'No single check is sufficient on its own; the strength of this verdict comes from the era-consistency across multiple independent dimensions.',
        'Cross-check the bag\'s style number against the model entry for additional dating signals (palette, dimensions, era-specific features).',
        'For high-value purchases, a community second opinion is still worthwhile — see the PurseForum link below.',
      ];
    }

    const v = document.createElement('div');
    v.className = 'wiz-verdict';
    /* role=status + aria-live=polite makes the verdict announcement
     * non-disruptive but still surfaced to AT once the wizard's tree
     * has finished mutating. The h2 'verdict-heading' gets focus so
     * sighted keyboard users see the result immediately. */
    v.setAttribute('role', 'status');
    v.setAttribute('aria-live', 'polite');
    v.innerHTML = `
      <h2 class="verdict-heading" tabindex="-1" id="wiz-verdict-heading">${verdictLabel}</h2>
      <span class="verdict-tag" data-verdict="${verdict}" aria-hidden="true">${verdictLabel}</span>
      <p>${summary}</p>
      <h3>What this means</h3>
      <ul>${body.map(b => `<li>${b}</li>`).join('')}</ul>
      <h3>Read next</h3>
      <ul class="next-reads">
        ${nextReads(verdict, noCreed).map(r => `
          <li><a href="${r.url}"><strong>${r.title}</strong><span class="sub">${r.sub}</span></a></li>
        `).join('')}
      </ul>
    `;
    wiz.appendChild(v);

    renderControls();
    renderTrail();

    /* Move focus to the verdict so keyboard + AT users land at the
     * answer, not at the bottom of the wizard's previous question. */
    const heading = v.querySelector('.verdict-heading');
    if (heading) heading.focus();
  }

  function nextReads(verdict, noCreed) {
    const reads = [
      { url: `${wizardBase}authentication/decision-tree/`, title: 'Decision tree', sub: 'Printable one-page reference covering the same flow' },
    ];
    if (noCreed) {
      reads.push({ url: `${wizardBase}authentication/pre-creed-era/`, title: 'Pre-creed era', sub: 'How to authenticate Cashin-era bags without a creed' });
      reads.push({ url: `${wizardBase}authentication/hardware/`, title: 'Hardware', sub: 'Brass turnlock construction, the magnet test, dogleash clip' });
      reads.push({ url: `${wizardBase}authentication/leather/`, title: 'Leather', sub: 'Glove-tanned cowhide, edge treatment, smell' });
    } else if (verdict === 'red-flags') {
      reads.push({ url: `${wizardBase}authentication/country-of-origin/`, title: 'Country of origin', sub: 'Era-inconsistency = fake; per-country progression' });
      reads.push({ url: `${wizardBase}authentication/creed-formats/`, title: 'Creed formats', sub: 'Era-by-era breakdown of the leather creed wording' });
      reads.push({ url: `${wizardBase}authentication/counterfeits/`, title: 'Counterfeit catalog', sub: 'Documented fake families' });
    } else {
      reads.push({ url: `${wizardBase}authentication/creed-formats/`, title: 'Creed formats', sub: 'Pin the bag\'s era window from the creed wording' });
      reads.push({ url: `${wizardBase}authentication/serial-numbers/`, title: 'Serial numbers', sub: 'Decode the serial; single-digit-year ambiguity caveat' });
      reads.push({ url: `${wizardBase}authentication/hardware/`, title: 'Hardware', sub: 'The magnet test, brass patina, turnlock construction' });
    }
    return reads;
  }

  /* Reveal the wizard once the script has executed; with JS off the
   * div stays hidden and the noscript fallback is the only content
   * the user sees. */
  wiz.hidden = false;
  render();
</script>
