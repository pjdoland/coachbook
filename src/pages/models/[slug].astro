---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { summarize } from '../../lib/evidence.ts';

export async function getStaticPaths() {
  const models = await getCollection('models');
  return models.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, allModels: models },
  }));
}

const { entry, allModels } = Astro.props;
const { Content } = await render(entry);
const label = entry.data.name ?? entry.data.title ?? entry.id;
const base = import.meta.env.BASE_URL;

// schema.org Product: a vintage Coach silhouette is a manufactured
// good, even if production has long ended. Captures style numbers,
// designer (when known), brand (Coach), and citations.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: label,
  description: `${label} — vintage Coach Leatherware${entry.data.era ? `, ${entry.data.era} era` : ''}.`,
  brand: { '@type': 'Brand', name: 'Coach' },
  category: 'Handbag',
  ...(entry.data.style_numbers && entry.data.style_numbers.length > 0
    ? { sku: entry.data.style_numbers.join(', '), productID: entry.data.style_numbers[0] }
    : {}),
  ...(entry.data.designer
    ? { designer: { '@type': 'Person', name: entry.data.designer } }
    : {}),
  ...(entry.data.also_known_as && entry.data.also_known_as.length > 0
    ? { alternateName: entry.data.also_known_as }
    : {}),
  ...(entry.data.introduced ? { releaseDate: String(entry.data.introduced) } : {}),
  ...(entry.data.discontinued
    ? { productionDate: `${entry.data.introduced ?? ''}/${entry.data.discontinued}` }
    : {}),
};

// Resolve the related: frontmatter array (slug strings) to actual model
// entries. Drop any that don't resolve so a typo doesn't crash the build.
const relatedSlugs = entry.data.related ?? [];
const related = relatedSlugs
  .map((slug) => allModels.find((m) => m.id === slug))
  .filter((m) => m != null);

const evidence = summarize(entry.data.sources);
---

<BaseLayout title={label} jsonLd={jsonLd}>
  <article>
    <Breadcrumbs trail={[
      { label: 'Models', href: `${base}models/` },
      { label },
    ]} />
    <h1>{label}</h1>
    <dl>
      {
        entry.data.style_numbers && entry.data.style_numbers.length > 0 && (
          <>
            <dt>Style number{entry.data.style_numbers.length === 1 ? '' : 's'}</dt>
            <dd>{entry.data.style_numbers.join(', ')}</dd>
          </>
        )
      }
      {entry.data.era && (<><dt>Era</dt><dd>{entry.data.era}{entry.data.era_code && (<><span class="era-code-pill">{entry.data.era_code}</span></>)}</dd></>)}
      {entry.data.introduced && (<><dt>Introduced</dt><dd>{entry.data.introduced}</dd></>)}
      {entry.data.discontinued && (<><dt>Discontinued</dt><dd>{entry.data.discontinued}</dd></>)}
      {entry.data.designer && (<><dt>Designer</dt><dd>{entry.data.designer}</dd></>)}
      {entry.data.closure && (<><dt>Closure</dt><dd>{entry.data.closure}</dd></>)}
      {entry.data.confidence && (<><dt>Confidence</dt><dd><span class="chip" data-confidence={entry.data.confidence}>{entry.data.confidence}</span></dd></>)}
      {entry.data.status && (<><dt>Status</dt><dd>{entry.data.status}</dd></>)}
    </dl>
    <Content />

    {entry.data.facts && entry.data.facts.length > 0 && (
      <section class="facts-block" id="facts">
        <h2>Facts and provenance</h2>
        <p class="facts-intro">
          Per-claim breakdown: each statement carries its confidence,
          the sources that support it (with tier), and a permalink so
          the claim can be cited directly.
        </p>
        <ol class="facts-list">
          {entry.data.facts.map((f, i) => {
            const factEvidence = summarize(f.sources);
            const factId = `fact-${i + 1}`;
            return (
              <li id={factId} class="fact" data-confidence={f.confidence}>
                <p class="fact-claim">
                  {f.claim}
                  <a class="fact-anchor" href={`#${factId}`} aria-label="Permalink to this fact">#</a>
                </p>
                <p class="fact-meta">
                  <span class="chip" data-confidence={f.confidence}>{f.confidence}</span>
                  {factEvidence.best && (
                    <span class="tier-pill" data-tier={factEvidence.best}>Tier {factEvidence.best}</span>
                  )}
                  <span class="fact-sources">
                    {factEvidence.cited.map((c, j) => (
                      <>
                        {j > 0 && ' · '}
                        <a href={`${base}sources/#${c.id}`} class="source-cite">[{c.id}]</a>
                        {c.tier && <span class="tier-pill tier-pill-inline" data-tier={c.tier}>T{c.tier}</span>}
                      </>
                    ))}
                  </span>
                </p>
                {f.notes && <p class="fact-notes">{f.notes}</p>}
              </li>
            );
          })}
        </ol>
      </section>
    )}

    {related.length > 0 && (
      <section class="related-models">
        <h2>Related models</h2>
        <ul class="card-grid">
          {related.map((m) => {
            const mlabel = m.data.name ?? m.data.title ?? m.id;
            const meta = [
              (m.data.style_numbers ?? []).join(', ') || null,
              m.data.era ?? null,
            ].filter(Boolean).join(' · ');
            return (
              <li>
                <a href={`${base}models/${m.id}/`}>
                  <strong>{mlabel}</strong>
                  {meta && <span class="card-meta">{meta}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <section class="authenticate-this">
      <h2>Authenticate a {label}</h2>
      <p>
        Don't authenticate on a single feature — combine the era-keyed
        signals across creed, hardware, hangtag, stitching, and country
        of origin. Start at the wizard or jump to the topic.
      </p>
      <ul class="card-grid">
        <li><a href={`${base}wizard/`}><strong>Wizard</strong><span class="card-meta">Step-through · 6 questions</span></a></li>
        <li><a href={`${base}authentication/decision-tree/`}><strong>Decision tree</strong><span class="card-meta">One-page reference</span></a></li>
        <li><a href={`${base}creed-formats/`}><strong>Creed formats</strong><span class="card-meta">By era</span></a></li>
        <li><a href={`${base}authentication/hardware/`}><strong>Hardware</strong><span class="card-meta">Turnlocks, dogleash, tells</span></a></li>
        <li><a href={`${base}authentication/hangtags/`}><strong>Hangtags</strong><span class="card-meta">Beanbag silhouette + stamps</span></a></li>
        <li><a href={`${base}authentication/country-of-origin/`}><strong>Country of origin</strong><span class="card-meta">"Made in" line by era</span></a></li>
        <li><a href={`${base}authentication/stitching/`}><strong>Stitching</strong><span class="card-meta">12 SPI · not saddle-stitched</span></a></li>
        <li><a href={`${base}authentication/coach-repair/`}><strong>Coach Repair caveat</strong><span class="card-meta">Wrong-era part ≠ fake</span></a></li>
      </ul>
    </section>

    {
      entry.data.sources && entry.data.sources.length > 0 && (
        <section>
          <h2>Sources</h2>
          <p class="evidence-summary" data-tier={evidence.best ?? 'none'}>
            <strong>{evidence.label}.</strong>
            {' '}
            {evidence.total} {evidence.total === 1 ? 'source' : 'sources'} cited
            {evidence.best && (
              <>
                {' · '}
                {Object.entries(evidence.byTier)
                  .filter(([, n]) => n > 0)
                  .map(([t, n], i, arr) => (
                    <>
                      {i > 0 && ' · '}<span class="tier-pill" data-tier={t}>Tier {t}: {n}</span>
                    </>
                  ))}
              </>
            )}
          </p>
          <ul class="source-list">
            {evidence.cited.map((c) => (
              <li>
                <a href={`${base}sources/#${c.id}`} class="source-cite">[{c.id}]</a>
                {c.tier && <span class="tier-pill" data-tier={c.tier}>Tier {c.tier}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .authenticate-this {
    margin-top: 2.5rem;
    padding: 1.25rem 1.25rem 0.5rem;
    background: var(--paper-soft);
    border-left: 3px solid var(--brass);
  }
  .authenticate-this h2 {
    margin-top: 0;
    font-size: 1.3rem;
  }
  .authenticate-this p {
    color: var(--ink-soft);
    max-width: 60ch;
  }
  .source-list {
    list-style: none;
    padding-left: 0;
  }
  .source-list li {
    margin: 0.25rem 0;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }
  .evidence-summary {
    margin: 0 0 0.85rem;
    padding: 0.7rem 0.95rem;
    background: var(--paper-soft);
    border-left: 3px solid var(--bridle);
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .evidence-summary[data-tier="1"] { border-left-color: var(--brass-deep); }
  .evidence-summary[data-tier="2"] { border-left-color: var(--brass); }
  .evidence-summary[data-tier="3"] { border-left-color: var(--bridle); }
  .evidence-summary[data-tier="4"] { border-left-color: var(--surface-line); }
  .tier-pill {
    display: inline-block;
    padding: 0.05rem 0.45rem;
    font-size: 0.72rem;
    font-family: 'Inter', sans-serif;
    letter-spacing: 0.04em;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-soft);
    border: 1px solid var(--surface-line);
    line-height: 1.5;
    white-space: nowrap;
  }
  .tier-pill[data-tier="1"] { background: var(--brass-deep); color: var(--paper); border-color: var(--brass-deep); }
  .tier-pill[data-tier="2"] { background: var(--brass); color: var(--paper); border-color: var(--brass); }
  .tier-pill[data-tier="3"] { background: var(--bridle-soft); color: var(--ink); border-color: var(--bridle-soft); }
  .tier-pill[data-tier="4"] { background: var(--paper); color: var(--ink-quiet); }
  .era-code-pill {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.4rem;
    background: var(--bridle);
    color: var(--paper);
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 3px;
    vertical-align: 0.15em;
    letter-spacing: 0.04em;
  }

  .facts-block { margin-top: 2.5rem; }
  .facts-intro { color: var(--ink-soft); max-width: 60ch; margin-top: 0; }
  .facts-list {
    list-style: none;
    padding-left: 0;
    margin: 1.25rem 0 0;
    counter-reset: fact;
  }
  .fact {
    padding: 0.85rem 1rem 0.85rem 2.4rem;
    margin: 0 0 0.5rem;
    background: var(--surface);
    border: 1px solid var(--surface-line);
    border-left: 3px solid var(--bridle);
    border-radius: 3px;
    position: relative;
    counter-increment: fact;
  }
  .fact::before {
    content: counter(fact);
    position: absolute;
    left: 0.85rem;
    top: 0.95rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--brass-deep);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .fact[data-confidence="confirmed"] { border-left-color: var(--brass-deep); }
  .fact[data-confidence="likely"] { border-left-color: var(--brass); }
  .fact[data-confidence="tentative"] { border-left-color: var(--bridle); }
  .fact[data-confidence="disputed"] { border-left-color: #b15a3c; }
  .fact-claim {
    margin: 0 0 0.4rem;
    color: var(--ink);
    line-height: 1.5;
  }
  .fact-meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .fact-notes {
    margin: 0.5rem 0 0;
    font-size: 0.88rem;
    color: var(--ink-soft);
    font-style: italic;
    line-height: 1.5;
  }
  .fact-anchor {
    margin-left: 0.5rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78em;
    color: var(--ink-quiet);
    text-decoration: none;
    opacity: 0;
    transition: opacity 120ms ease, color 120ms ease;
  }
  .fact:hover .fact-anchor,
  .fact:focus-within .fact-anchor,
  .fact-anchor:focus-visible {
    opacity: 1;
    color: var(--brass-deep);
  }
  .fact:target {
    background: rgba(138, 106, 43, 0.08);
    box-shadow: 0 0 0 2px var(--brass-soft);
  }
  .tier-pill-inline {
    margin-left: 0.25rem;
    font-size: 0.65rem;
    padding: 0 0.3rem;
  }
</style>
