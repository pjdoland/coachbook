---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const models = (await getCollection('models')).slice().sort((a, b) =>
  (a.data.name ?? a.data.title ?? a.id).localeCompare(
    b.data.name ?? b.data.title ?? b.id,
  ),
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Models" description="All vintage Coach models in the archive.">
  <h1>Models</h1>
  <p>{models.length} model{models.length === 1 ? '' : 's'} in the archive.</p>
  <ul>
    {
      models.map((entry) => {
        const label = entry.data.name ?? entry.data.title ?? entry.id;
        return (
          <li>
            <a href={`${base}models/${entry.id}/`}>{label}</a>
            {entry.data.style_numbers && entry.data.style_numbers.length > 0 && (
              <small> — {entry.data.style_numbers.join(', ')}</small>
            )}
            {entry.data.era && <small> — {entry.data.era}</small>}
            {entry.data.confidence && (
              <small> — {entry.data.confidence}</small>
            )}
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
