---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allModels = (await getCollection('models')).slice().sort((a, b) =>
  (a.data.name ?? a.data.title ?? a.id).localeCompare(
    b.data.name ?? b.data.title ?? b.id,
  ),
);
const base = import.meta.env.BASE_URL;

// Era buckets — match the codes used in history.astro / authentication
// frontmatter. The list is human-readable so the filter buttons read
// the same as the timeline.
const ERAS = [
  { code: 'E1', label: 'Pre-Cashin', range: '1941–1961' },
  { code: 'E2', label: 'Cashin', range: '1962–1974' },
  { code: 'E3', label: 'Early NYC', range: '1975–1984' },
  { code: 'E4', label: 'Late NYC', range: '1985–1994' },
  { code: 'E5', label: 'Krakoff transition', range: '1995–2002' },
];

// Normalize the per-entry era field into a list of era codes. Many
// bags genuinely span multiple eras (e.g. "cashin-through-classic-nyc",
// "classic-nyc-late") and should match a filter for any window they
// touch. Returns a sorted array of E-codes.
function normalizeEras(raw) {
  if (!raw) return [];
  const s = String(raw).toLowerCase();
  const out = new Set();
  const codeMatches = s.match(/\be[1-5]\b/gi);
  if (codeMatches) codeMatches.forEach((m) => out.add(m.toUpperCase()));
  if (s.includes('pre-cashin') || s.includes('or-earlier')) out.add('E1');
  if (s.includes('cashin')) out.add('E2');
  if (s.includes('classic-nyc') || s.includes('early-nyc') || s.includes('post-cashin') || s.includes('1970')) out.add('E3');
  if (s.includes('classic-nyc-late') || s.includes('late-nyc') || s.includes('1985') || s.includes('1989') || s.includes('lightweight')) out.add('E4');
  if (s.includes('krakoff') || s.includes('transition') || (s.includes('199') && /\b(199[5-9]|200[0-2])\b/.test(s))) out.add('E5');
  return [...out].sort();
}

// Bag → primary era for sectioning. Specific tokens in the raw era
// string override generic groupings: 'classic-nyc-late' goes to E4,
// not E3; 'cashin-or-classic-nyc' goes to E2 (the earlier window is
// usually the more diagnostic anchor for compound entries). Falls
// through to the earliest normalized era code.
function primaryEra(raw, eras) {
  if (!raw) return eras[0] ?? null;
  const s = String(raw).toLowerCase();
  if (s.includes('krakoff')) return 'E5';
  if (s.includes('classic-nyc-late') || s.includes('late-nyc')) return 'E4';
  if (s.includes('lightweight') && s.includes('1989')) return 'E4';
  if (s.includes('classic-nyc') && !s.includes('cashin')) return 'E3';
  if (s.includes('cashin') && !s.includes('pre-cashin')) return 'E2';
  if (s.includes('pre-cashin')) return 'E1';
  return eras[0] ?? null;
}

// Pre-bucket models into per-era sections so the page renders as a
// chronology rather than an A-Z wall.
const buckets = new Map();
const unsorted = [];
for (const era of ERAS) buckets.set(era.code, []);

for (const entry of allModels) {
  const eras = normalizeEras(entry.data.era);
  const home = primaryEra(entry.data.era, eras);
  const card = {
    id: entry.id,
    label: entry.data.name ?? entry.data.title ?? entry.id,
    style_numbers: entry.data.style_numbers ?? [],
    aliases: entry.data.also_known_as ?? [],
    era: entry.data.era ?? '',
    eraCodes: eras.join(' '),
    confidence: entry.data.confidence ?? '',
  };
  if (home) buckets.get(home).push(card);
  else unsorted.push(card);
}
---

<BaseLayout title="Models" description="All vintage Coach models in the archive.">
  <h1>Models</h1>
  <p class="lede">
    {allModels.length} silhouettes from the Cashin era through the
    Krakoff transition. Grouped chronologically by era; each entry
    carries catalog citations where available.
  </p>

  <div class="filters" role="region" aria-label="Filter models">
    <label class="filter-search">
      <span class="visually-hidden">Search models by name or style number</span>
      <input
        type="search"
        id="model-filter-q"
        placeholder="Search by name or style number…"
        autocomplete="off"
      />
    </label>

    <fieldset class="filter-eras">
      <legend class="visually-hidden">Filter by era</legend>
      <button type="button" class="era-pill is-active" data-era="">All</button>
      {ERAS.map((e) => (
        <button type="button" class="era-pill" data-era={e.code}>
          <span class="pill-code">{e.code}</span>
          <span class="pill-label">{e.label}</span>
        </button>
      ))}
    </fieldset>

    <p class="filter-status" id="model-filter-status" aria-live="polite">
      {allModels.length} models
    </p>
  </div>

  <div id="model-sections">
    {ERAS.map((era) => {
      const items = buckets.get(era.code);
      if (!items || items.length === 0) return null;
      return (
        <section class="era-section" data-era={era.code}>
          <header class="era-heading">
            <h2>
              <span class="era-code">{era.code}</span>
              {era.label}
            </h2>
            <span class="era-range">{era.range}</span>
            <span class="era-count">
              {items.length} {items.length === 1 ? 'model' : 'models'}
            </span>
          </header>
          <ul class="card-grid model-list">
            {items.map((c) => (
              <li
                class="model-card"
                data-name={c.label.toLowerCase()}
                data-haystack={[c.label, ...c.aliases, ...c.style_numbers, c.era, c.id].join(' ').toLowerCase()}
                data-era={c.eraCodes}
                data-confidence={c.confidence}
              >
                <a href={`${base}models/${c.id}/`}>
                  <strong>{c.label}</strong>
                  {(c.style_numbers.length > 0 || c.era) && (
                    <span class="card-meta">
                      {[c.style_numbers.join(', ') || null, c.era || null].filter(Boolean).join(' · ')}
                    </span>
                  )}
                  {c.confidence && (
                    <span class="chip" data-confidence={c.confidence}>{c.confidence}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}

    {unsorted.length > 0 && (
      <section class="era-section" data-era="unsorted">
        <header class="era-heading">
          <h2>Unsorted</h2>
          <span class="era-range">Era unparsed</span>
          <span class="era-count">{unsorted.length}</span>
        </header>
        <ul class="card-grid model-list">
          {unsorted.map((c) => (
            <li
              class="model-card"
              data-name={c.label.toLowerCase()}
              data-haystack={[c.label, ...c.aliases, ...c.style_numbers, c.era, c.id].join(' ').toLowerCase()}
              data-era={c.eraCodes}
              data-confidence={c.confidence}
            >
              <a href={`${base}models/${c.id}/`}>
                <strong>{c.label}</strong>
                {(c.style_numbers.length > 0 || c.era) && (
                  <span class="card-meta">
                    {[c.style_numbers.join(', ') || null, c.era || null].filter(Boolean).join(' · ')}
                  </span>
                )}
                {c.confidence && (
                  <span class="chip" data-confidence={c.confidence}>{c.confidence}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <p class="empty-state" id="model-filter-empty" hidden>
    No models match. Try a different search term or clear the era filter.
  </p>
</BaseLayout>

<script>
  const root = document.getElementById('model-sections');
  const q = document.getElementById('model-filter-q');
  const status = document.getElementById('model-filter-status');
  const empty = document.getElementById('model-filter-empty');
  const pills = document.querySelectorAll('.era-pill');
  if (root && q && status && empty) {
    const sections = Array.from(root.querySelectorAll('.era-section'));
    const cards = Array.from(root.querySelectorAll('.model-card'));
    let activeEra = '';
    let activeQuery = '';

    const apply = () => {
      const needle = activeQuery.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const eras = (card.dataset.era || '').split(/\s+/).filter(Boolean);
        const matchesEra = !activeEra || eras.includes(activeEra);
        const matchesQ = !needle || (card.dataset.haystack || '').includes(needle);
        const visible = matchesEra && matchesQ;
        card.hidden = !visible;
        if (visible) shown += 1;
      }
      // Hide whole era sections that are now empty.
      for (const section of sections) {
        const visibleHere = section.querySelectorAll('.model-card:not([hidden])').length;
        section.hidden = visibleHere === 0;
      }
      status.textContent = `${shown} model${shown === 1 ? '' : 's'}`;
      empty.hidden = shown !== 0;
    };

    q.addEventListener('input', (e) => {
      activeQuery = (e.target as HTMLInputElement).value;
      apply();
    });

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activeEra = pill.dataset.era || '';
        pills.forEach((p) => p.classList.toggle('is-active', p === pill));
        apply();
      });
    });
  }
</script>

<style>
  .lede { font-size: 1.05rem; color: var(--ink-soft); margin-bottom: 1rem; max-width: 60ch; }
  .filters {
    margin: 1.25rem 0 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .filter-search input {
    width: 100%;
    padding: 0.65rem 0.85rem;
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--surface-line);
    border-radius: 3px;
    min-height: 44px;
  }
  .filter-search input:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: 1px;
    border-color: var(--brass);
  }
  .filter-eras {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .era-pill {
    appearance: none;
    background: var(--paper);
    border: 1px solid var(--surface-line);
    color: var(--ink-soft);
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font: inherit;
    font-size: 0.85rem;
    line-height: 1.2;
    cursor: pointer;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: border-color 120ms ease, background 120ms ease, color 120ms ease;
  }
  .era-pill:hover { border-color: var(--brass); }
  .era-pill:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: 1px;
  }
  .era-pill.is-active {
    background: var(--bridle);
    border-color: var(--bridle);
    color: var(--paper);
  }
  .era-pill.is-active .pill-code { color: var(--paper-soft); }
  .era-pill .pill-code {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 600;
    color: var(--brass-deep);
  }
  .filter-status {
    margin: 0;
    font-size: 0.82rem;
    color: var(--ink-quiet);
    font-variant-numeric: tabular-nums;
  }
  .era-section { margin-top: 2.25rem; }
  .era-section:first-of-type { margin-top: 1rem; }
  .era-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.85rem;
    margin: 0 0 0.85rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--surface-line);
  }
  .era-heading h2 {
    margin: 0;
    font-size: 1.45rem;
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
  }
  .era-heading .era-code {
    display: inline-block;
    min-width: 1.6rem;
    padding: 0.05em 0.4em;
    background: var(--bridle);
    color: var(--paper);
    border-radius: 3px;
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    text-align: center;
    vertical-align: 0.2em;
  }
  .era-heading .era-range {
    font-size: 0.92rem;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .era-heading .era-count {
    font-size: 0.82rem;
    color: var(--ink-quiet);
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }
  .empty-state {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--paper-soft);
    border-left: 3px solid var(--bridle);
    color: var(--ink-soft);
  }
  .card-grid .chip { margin-top: 0.4rem; }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
