---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const models = (await getCollection('models')).slice().sort((a, b) =>
  (a.data.name ?? a.data.title ?? a.id).localeCompare(
    b.data.name ?? b.data.title ?? b.id,
  ),
);
const base = import.meta.env.BASE_URL;

// Era buckets — match the codes used in history.astro / authentication
// frontmatter. The list is human-readable so the filter buttons read
// the same as the timeline.
const ERAS = [
  { code: 'E1', label: 'Pre-Cashin', range: '1941–1961' },
  { code: 'E2', label: 'Cashin', range: '1962–1974' },
  { code: 'E3', label: 'Early NYC', range: '1975–1984' },
  { code: 'E4', label: 'Late NYC', range: '1985–1994' },
  { code: 'E5', label: 'Krakoff transition', range: '1995–2002' },
];

// Normalize the per-entry era field (which can be 'E2', 'cashin',
// 'classic-nyc', etc.) into a code so the data-attribute is uniform.
function normalizeEra(raw) {
  if (!raw) return '';
  const s = String(raw).toLowerCase();
  if (/^e[1-5]/.test(s)) return s.slice(0, 2).toUpperCase();
  if (s.includes('pre-cashin')) return 'E1';
  if (s.includes('cashin')) return 'E2';
  if (s.includes('classic-nyc') || s.includes('early-nyc')) return 'E3';
  if (s.includes('late-nyc') || s.includes('transition') && !s.includes('krakoff')) return 'E4';
  if (s.includes('krakoff')) return 'E5';
  return '';
}
---

<BaseLayout title="Models" description="All vintage Coach models in the archive.">
  <h1>Models</h1>
  <p class="lede">
    {models.length} silhouettes from the Cashin era through the Krakoff
    transition. Each entry carries catalog citations where available;
    community sources are flagged where they aren't.
  </p>

  <div class="filters" role="region" aria-label="Filter models">
    <label class="filter-search">
      <span class="visually-hidden">Search models by name or style number</span>
      <input
        type="search"
        id="model-filter-q"
        placeholder="Search by name or style number…"
        autocomplete="off"
      />
    </label>

    <fieldset class="filter-eras">
      <legend class="visually-hidden">Filter by era</legend>
      <button type="button" class="era-pill is-active" data-era="">All</button>
      {ERAS.map((e) => (
        <button type="button" class="era-pill" data-era={e.code}>
          <span class="pill-code">{e.code}</span>
          <span class="pill-label">{e.label}</span>
        </button>
      ))}
    </fieldset>

    <p class="filter-status" id="model-filter-status" aria-live="polite">
      {models.length} models
    </p>
  </div>

  <ul class="card-grid model-list" id="model-list">
    {
      models.map((entry) => {
        const label = entry.data.name ?? entry.data.title ?? entry.id;
        const styles = entry.data.style_numbers ?? [];
        const aliases = entry.data.also_known_as ?? [];
        const eraCode = normalizeEra(entry.data.era);
        const meta = [
          styles.length > 0 ? styles.join(', ') : null,
          entry.data.era ?? null,
        ].filter(Boolean).join(' · ');
        const haystack = [
          label,
          ...aliases,
          ...styles,
          entry.data.era ?? '',
          entry.id,
        ].join(' ').toLowerCase();
        return (
          <li
            class="model-card"
            data-name={label.toLowerCase()}
            data-haystack={haystack}
            data-era={eraCode}
            data-confidence={entry.data.confidence ?? ''}
          >
            <a href={`${base}models/${entry.id}/`}>
              <strong>{label}</strong>
              {meta && <span class="card-meta">{meta}</span>}
              {entry.data.confidence && (
                <span class="chip" data-confidence={entry.data.confidence}>
                  {entry.data.confidence}
                </span>
              )}
            </a>
          </li>
        );
      })
    }
  </ul>

  <p class="empty-state" id="model-filter-empty" hidden>
    No models match. Try a different search term or clear the era filter.
  </p>
</BaseLayout>

<script>
  const list = document.getElementById('model-list');
  const q = document.getElementById('model-filter-q');
  const status = document.getElementById('model-filter-status');
  const empty = document.getElementById('model-filter-empty');
  const pills = document.querySelectorAll('.era-pill');
  if (list && q && status && empty) {
    const cards = Array.from(list.querySelectorAll('.model-card'));
    let activeEra = '';
    let activeQuery = '';

    const apply = () => {
      const needle = activeQuery.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const matchesEra = !activeEra || card.dataset.era === activeEra;
        const matchesQ = !needle || (card.dataset.haystack || '').includes(needle);
        const visible = matchesEra && matchesQ;
        card.hidden = !visible;
        if (visible) shown += 1;
      }
      status.textContent = `${shown} model${shown === 1 ? '' : 's'}`;
      empty.hidden = shown !== 0;
    };

    q.addEventListener('input', (e) => {
      activeQuery = (e.target as HTMLInputElement).value;
      apply();
    });

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activeEra = pill.dataset.era || '';
        pills.forEach((p) => p.classList.toggle('is-active', p === pill));
        apply();
      });
    });
  }
</script>

<style>
  .lede { font-size: 1.05rem; color: var(--ink-soft); margin-bottom: 1rem; max-width: 60ch; }
  .filters {
    margin: 1.25rem 0 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .filter-search input {
    width: 100%;
    padding: 0.65rem 0.85rem;
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--surface-line);
    border-radius: 3px;
    min-height: 44px;
  }
  .filter-search input:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: 1px;
    border-color: var(--brass);
  }
  .filter-eras {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .era-pill {
    appearance: none;
    background: var(--paper);
    border: 1px solid var(--surface-line);
    color: var(--ink-soft);
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font: inherit;
    font-size: 0.85rem;
    line-height: 1.2;
    cursor: pointer;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: border-color 120ms ease, background 120ms ease, color 120ms ease;
  }
  .era-pill:hover { border-color: var(--brass); }
  .era-pill:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: 1px;
  }
  .era-pill.is-active {
    background: var(--bridle);
    border-color: var(--bridle);
    color: var(--paper);
  }
  .era-pill.is-active .pill-code { color: var(--paper-soft); }
  .era-pill .pill-code {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 600;
    color: var(--brass-deep);
  }
  .filter-status {
    margin: 0;
    font-size: 0.82rem;
    color: var(--ink-quiet);
    font-variant-numeric: tabular-nums;
  }
  .empty-state {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--paper-soft);
    border-left: 3px solid var(--bridle);
    color: var(--ink-soft);
  }
  .card-grid .chip { margin-top: 0.4rem; }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
