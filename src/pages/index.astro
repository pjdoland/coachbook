---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const [models, designers, authentication, colors, catalogs, history] = await Promise.all([
  getCollection('models'),
  getCollection('designers'),
  getCollection('authentication'),
  getCollection('colors'),
  getCollection('catalogs'),
  getCollection('history'),
]);

const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/pjdoland/coachbook/blob/main';
---

<BaseLayout
  title="coachbook"
  description="Vintage Coach handbag archive — reference for the 1941–2002 NYC era."
>
  <h1>coachbook</h1>
  <p>
    A reference archive of vintage Coach Leatherware (1941–2002), built
    from free public sources with citation discipline. See
    <a href={`${repo}/PLAN.md`}>PLAN</a> for scope and
    <a href={`${repo}/STYLE.md`}>STYLE</a> for editorial conventions.
  </p>

  <section>
    <h2>Start here</h2>
    <ul>
      <li><a href={`${base}authentication/decision-tree/`}>Authentication decision tree</a> — "is this real?" in seven steps</li>
      <li><a href={`${base}authentication/`}>Authentication topics</a> ({authentication.length})</li>
      <li><a href={`${base}history/`}>Company timeline</a> 1941–2002</li>
      <li><a href={`${base}designers/`}>Designers and people</a> ({designers.length})</li>
    </ul>
  </section>

  <section>
    <h2>Browse</h2>
    <ul>
      <li><a href={`${base}models/`}>Models</a> ({models.length}) — every documented vintage Coach silhouette</li>
      <li><a href={`${base}colors/`}>Colors</a> ({colors.length}) — the Coach palette, era-by-era</li>
      <li><a href={`${base}catalogs/`}>Catalogs</a> ({catalogs.length}) — primary-source catalog records</li>
    </ul>
  </section>

  <section>
    <h2>Reference</h2>
    <ul>
      <li><a href={`${repo}/bibliography.md`}>Bibliography</a></li>
      <li><a href={`${repo}/market.md`}>Market and pricing</a></li>
      <li><a href={`${repo}/care/`}>Care and restoration</a></li>
      <li><a href={`${repo}/errata.md`}>Errata</a> — corrections log</li>
    </ul>
  </section>

  <section>
    <h2>Confidence</h2>
    <p>
      Every claim in this archive carries a confidence tag and a source
      citation. <code>confirmed</code> = primary source or two independent
      reputable sources; <code>likely</code> = single primary or
      multiple agreeing secondary; <code>tentative</code> = community
      sources only; <code>disputed</code> = sources disagree, both shown.
    </p>
    <p>
      Many entries are currently <code>tentative</code> — Phase 3 retrieval
      operations (see <a href={`${repo}/RETRIEVAL.md`}>RETRIEVAL</a>) will
      upgrade them as primary sources are pulled.
    </p>
  </section>
</BaseLayout>
