---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const [models, designers, authentication, colors, catalogs] = await Promise.all([
  getCollection('models'),
  getCollection('designers'),
  getCollection('authentication'),
  getCollection('colors'),
  getCollection('catalogs'),
]);

const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/pjdoland/coachbook/blob/main';
---

<BaseLayout
  title="coachbook"
  description="Vintage Coach handbag archive — primary-source reference for the 1941–2002 NYC era."
>
  <p class="standfirst">Vintage Coach handbags, 1941–2002.</p>
  <h1>coachbook</h1>
  <p class="lede">
    A reference archive of vintage Coach Leatherware, 1941 through
    the Krakoff transition. Every claim is cited; every source is
    named; corrections are dated and logged.
  </p>
  <p class="thesis">
    Vintage Coach is the most folklore-prone vintage handbag category
    on the resale market: dated decoders that get the year wrong,
    Cashin attributions for bags introduced after her 1974 contract
    ended, "saddle-stitched" claims that don't match the brand's own
    catalog copy. This archive is what happens when the catalog corpus
    (107 issues, 1960–2020), the SEC filings, and the USPTO trademark
    record get read against each other and against the community
    record — and every disagreement gets a citation.
  </p>

  <section class="department">
    <p class="department-eyebrow">Authenticate</p>
    <h2>Is this bag real?</h2>
    <p class="department-blurb">
      No single signal proves a bag authentic or fake. Combine the
      era-windowed checks across creed, country, hardware, and
      construction.
    </p>
    <ul class="card-grid">
      <li>
        <a href={`${base}wizard/`}>
          <strong>Wizard</strong>
          <span class="card-meta">Step-through · 6 questions · cross-checked</span>
        </a>
      </li>
      <li>
        <a href={`${base}authentication/decision-tree/`}>
          <strong>Decision tree</strong>
          <span class="card-meta">Printable one-page reference</span>
        </a>
      </li>
      <li>
        <a href={`${base}authentication/`}>
          <strong>Topic index</strong>
          <span class="card-meta">{authentication.length} entries · grouped by what they tell you</span>
        </a>
      </li>
    </ul>
  </section>

  <section class="department">
    <p class="department-eyebrow">Browse the archive</p>
    <h2>What was Coach making?</h2>
    <p class="department-blurb">
      The catalog corpus, era by era — silhouettes, colorways, and the
      catalogs themselves. The company timeline anchors the dates.
    </p>
    <ul class="card-grid">
      <li>
        <a href={`${base}models/`}>
          <strong>Models</strong>
          <span class="card-meta">{models.length} silhouettes · grouped by era</span>
        </a>
      </li>
      <li>
        <a href={`${base}colors/`}>
          <strong>Colors</strong>
          <span class="card-meta">{colors.length} entries · era-by-era</span>
        </a>
      </li>
      <li>
        <a href={`${base}catalogs/`}>
          <strong>Catalogs</strong>
          <span class="card-meta">{catalogs.length} primary records</span>
        </a>
      </li>
      <li>
        <a href={`${base}designers/`}>
          <strong>Designers and people</strong>
          <span class="card-meta">{designers.length} entries</span>
        </a>
      </li>
      <li>
        <a href={`${base}history/`}>
          <strong>Company timeline</strong>
          <span class="card-meta">1941–2002</span>
        </a>
      </li>
    </ul>
  </section>

  <section class="department">
    <p class="department-eyebrow">The work</p>
    <h2>How the archive was built</h2>
    <p class="department-blurb">
      Citations, conflicts, corrections — the editorial substrate.
      Where claims come from, what's been disputed, what's been wrong.
    </p>
    <ul class="card-grid">
      <li><a href={`${base}sources/`}><strong>Source registry</strong><span class="card-meta">Canonical citation database</span></a></li>
      <li><a href={`${base}bibliography/`}><strong>Bibliography</strong><span class="card-meta">Human-readable, by type</span></a></li>
      <li><a href={`${base}research/`}><strong>Research method</strong><span class="card-meta">16 investigation streams</span></a></li>
      <li><a href={`${base}errata/`}><strong>Errata</strong><span class="card-meta">Corrections, dated</span></a></li>
      <li><a href={`${base}disputes/`}><strong>Disputes</strong><span class="card-meta">Where sources disagree</span></a></li>
      <li><a href={`${base}about/`}><strong>About</strong><span class="card-meta">Scope, standards, colophon</span></a></li>
    </ul>
  </section>

  <section class="department">
    <p class="department-eyebrow">In the repo</p>
    <h2>Reference</h2>
    <p class="department-blurb">
      Working files in the public repo — project scope, editorial
      conventions, and topics not yet promoted to standalone pages.
    </p>
    <ul class="card-grid">
      <li><a href={`${repo}/PLAN.md`}><strong>PLAN</strong><span class="card-meta">Project scope and method</span></a></li>
      <li><a href={`${repo}/STYLE.md`}><strong>STYLE</strong><span class="card-meta">Editorial conventions</span></a></li>
      <li><a href={`${repo}/market.md`}><strong>Market and pricing</strong><span class="card-meta">Pricing and resale notes</span></a></li>
      <li><a href={`${repo}/care/`}><strong>Care and restoration</strong><span class="card-meta">Cleaning, conditioning, repair</span></a></li>
    </ul>
  </section>

  <section class="department legend">
    <p class="department-eyebrow">Vocabulary</p>
    <h2>Confidence</h2>
    <p class="department-blurb">
      Every claim in the archive carries one of these tags.
    </p>
    <dl class="confidence-legend">
      <dt><span class="chip" data-confidence="confirmed">confirmed</span></dt>
      <dd>Primary source, or two independent reputable sources</dd>
      <dt><span class="chip" data-confidence="likely">likely</span></dt>
      <dd>Single primary, or multiple agreeing secondary sources</dd>
      <dt><span class="chip" data-confidence="tentative">tentative</span></dt>
      <dd>Community sources only, awaiting primary corroboration</dd>
      <dt><span class="chip" data-confidence="disputed">disputed</span></dt>
      <dd>Sources disagree; both readings shown side-by-side</dd>
    </dl>
  </section>
</BaseLayout>

<style>
  .standfirst {
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-quiet);
    margin: 0 0 0.5rem;
    font-weight: 500;
  }
  .lede {
    font-size: 1.08rem;
    color: var(--ink-soft);
    max-width: 60ch;
    margin-bottom: 1.25rem;
  }
  .thesis {
    color: var(--ink-soft);
    max-width: 64ch;
    margin: 0 0 2.5rem;
    line-height: 1.55;
  }
  .department {
    margin: 0 0 2.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--surface-line);
  }
  .department-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--brass-deep);
    font-weight: 600;
    margin: 0 0 0.25rem;
  }
  .department h2 {
    margin: 0 0 0.4rem;
    font-size: 1.55rem;
    line-height: 1.15;
  }
  .department-blurb {
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0 0 1rem;
  }
  .legend { margin-bottom: 1rem; }
  .confidence-legend {
    grid-template-columns: max-content 1fr;
    align-items: baseline;
  }
  .confidence-legend dt {
    font-weight: normal;
    color: var(--ink);
  }
  @media (max-width: 540px) {
    .confidence-legend dt { margin-top: 0.6rem; }
    .confidence-legend dt:first-child { margin-top: 0; }
  }
</style>
