---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const [models, designers, authentication, colors, catalogs, history] = await Promise.all([
  getCollection('models'),
  getCollection('designers'),
  getCollection('authentication'),
  getCollection('colors'),
  getCollection('catalogs'),
  getCollection('history'),
]);
---

<BaseLayout
  title="coachbook"
  description="Vintage Coach handbag archive — reference for the 1941–2002 NYC era."
>
  <h1>coachbook</h1>
  <p>
    A reference archive of vintage Coach Leatherware (1941–2002), built
    from free public sources with citation discipline. See
    <a href="/PLAN">PLAN</a> for scope and
    <a href="/STYLE">STYLE</a> for editorial conventions.
  </p>

  <section>
    <h2>Start here</h2>
    <ul>
      <li><a href="/authentication/decision-tree/">Authentication decision tree</a> — "is this real?" in seven steps</li>
      <li><a href="/authentication/">Authentication topics</a> ({authentication.length})</li>
      <li><a href="/history">Company timeline</a> 1941–2002</li>
      <li><a href="/designers/">Designers and people</a> ({designers.length})</li>
    </ul>
  </section>

  <section>
    <h2>Browse</h2>
    <ul>
      <li><a href="/models/">Models</a> ({models.length}) — every documented vintage Coach silhouette</li>
      <li><a href="/colors/">Colors</a> ({colors.length}) — the Coach palette, era-by-era</li>
      <li><a href="/catalogs/">Catalogs</a> ({catalogs.length}) — primary-source catalog records</li>
    </ul>
  </section>

  <section>
    <h2>Reference</h2>
    <ul>
      <li><a href="/bibliography">Bibliography</a></li>
      <li><a href="/market">Market and pricing</a></li>
      <li><a href="/care/">Care and restoration</a></li>
      <li><a href="/errata">Errata</a> — corrections log</li>
    </ul>
  </section>

  <section>
    <h2>Confidence</h2>
    <p>
      Every claim in this archive carries a confidence tag and a source
      citation. <code>confirmed</code> = primary source or two independent
      reputable sources; <code>likely</code> = single primary or
      multiple agreeing secondary; <code>tentative</code> = community
      sources only; <code>disputed</code> = sources disagree, both shown.
    </p>
    <p>
      Many entries are currently <code>tentative</code> — Phase 3 retrieval
      operations (see <a href="/RETRIEVAL">RETRIEVAL</a>) will upgrade
      them as primary sources are pulled.
    </p>
  </section>
</BaseLayout>
