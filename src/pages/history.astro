---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('history');
const timeline = entries.find((e) => e.id === 'timeline') ?? entries[0];
const { Content, headings } = timeline
  ? await render(timeline)
  : { Content: () => null, headings: [] };
const label = timeline?.data.title ?? 'Coach company timeline';

/* Build the navigation structure.
 *
 * - h2 headings = top-level page sections (Lead, Era summary, Timeline,
 *   Disputes, Open verification, Sources). Surface them as a small
 *   "Sections" list.
 * - h3 headings = individual events. Bucket each by the era window its
 *   year falls into. Headings without a parseable year get a best-effort
 *   assignment via "Pre-1969", "Late 1970s", "c. 1960" patterns.
 *
 * Era windows mirror PLAN.md / authentication conventions:
 *   E1 ≤ 1961  · pre-Cashin
 *   E2 1962–1974 · Cashin
 *   E3 1975–1984 · early NYC / pre-Sara-Lee
 *   E4 1985–1994 · late NYC / Sara Lee
 *   E5 1995–2002 · Krakoff transition (archive cutoff)
 */

const ERAS = [
  { code: 'E1', label: 'Pre-Cashin', range: '1941–1961', max: 1961, blurb: 'Founding as Gail Leather Products; Cahn family acquires the company.' },
  { code: 'E2', label: 'Cashin', range: '1962–1974', max: 1974, blurb: 'Bonnie Cashin contracted as designer; brass turnlock; the original Coach silhouettes.' },
  { code: 'E3', label: 'Early NYC', range: '1975–1984', max: 1984, blurb: 'Post-Cashin in-house era; mail-order growth; first retail stores.' },
  { code: 'E4', label: 'Late NYC', range: '1985–1994', max: 1994, blurb: 'Sara Lee acquisition; sub-collection diversification; peak heritage rhetoric.' },
  { code: 'E5', label: 'Krakoff transition', range: '1995–2002', max: 2002, blurb: 'Krakoff hire; offshoring; IPO; Signature C launch — vintage cutoff.' },
];

function inferYear(text) {
  const direct = text.match(/(\b|–|-)(19\d{2}|20\d{2})\b/);
  if (direct) return parseInt(direct[2], 10);
  const pre = text.match(/[Pp]re-(\d{4})/);
  if (pre) return parseInt(pre[1], 10) - 1;
  const decade = text.match(/(?:Late|Early|Mid)\s+(\d{4})s/);
  if (decade) return parseInt(decade[1], 10) + 5;
  const circa = text.match(/c\.?\s*(\d{4})/i);
  if (circa) return parseInt(circa[1], 10);
  return null;
}

function eraFor(year) {
  if (year == null) return null;
  for (const era of ERAS) if (year <= era.max) return era;
  return ERAS[ERAS.length - 1];
}

const topSections = headings.filter((h) => h.depth === 2);
const events = headings.filter((h) => h.depth === 3);

const eraGroups = ERAS.map((era) => ({
  ...era,
  events: events.filter((h) => eraFor(inferYear(h.text))?.code === era.code),
}));
---

<BaseLayout title={label}>
  <article>
    <h1 id="top">{label}</h1>
    <p class="lede">
      A chronology of Coach from its 1941 Manhattan founding through
      the 2001 Signature C launch. Read top-to-bottom, or jump to an
      era.
    </p>

    <nav class="history-toc" aria-label="Timeline navigation">
      <h2>Eras</h2>
      <ul class="era-grid">
        {eraGroups.map((era) => (
          <li>
            <a href={era.events[0]?.slug ? `#${era.events[0].slug}` : '#top'} class="era-card">
              <span class="era-code">{era.code}</span>
              <strong>{era.label}</strong>
              <span class="era-range">{era.range}</span>
              <span class="era-count">
                {era.events.length} {era.events.length === 1 ? 'event' : 'events'}
              </span>
              <span class="era-blurb">{era.blurb}</span>
            </a>
          </li>
        ))}
      </ul>

      {topSections.length > 0 && (
        <details class="sections-toggle">
          <summary>Other sections on this page</summary>
          <ul class="sections-list">
            {topSections.map((s) => (
              <li><a href={`#${s.slug}`}>{s.text}</a></li>
            ))}
          </ul>
        </details>
      )}
    </nav>

    {timeline && <div class="history-body"><Content /></div>}

    <p class="back-to-top"><a href="#top">↑ Back to top</a></p>
  </article>
</BaseLayout>

<style is:global>
  /* Styled is:global because some children render through Astro's
   * markdown renderer and don't carry the page's scoped class hash. */

  .history-toc {
    margin: 1.5rem 0 2.5rem;
  }
  .history-toc h2 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin: 0 0 0.75rem;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
  }

  .era-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (min-width: 540px) {
    .era-grid { grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
  }
  @media (min-width: 920px) {
    .era-grid { grid-template-columns: repeat(5, 1fr); }
  }
  .era-grid li { margin: 0; display: flex; }

  .era-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    width: 100%;
    padding: 0.85rem 0.95rem;
    background: var(--surface);
    border: 1px solid var(--surface-line);
    border-radius: 3px;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 120ms ease, background 120ms ease;
  }
  .era-card:hover, .era-card:focus-visible {
    border-color: var(--brass);
    background: var(--paper-soft);
  }
  .era-card .era-code {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--brass-deep);
  }
  .era-card strong {
    font-size: 1rem;
    line-height: 1.25;
    font-weight: 600;
  }
  .era-card .era-range {
    font-size: 0.82rem;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .era-card .era-count {
    font-size: 0.78rem;
    color: var(--ink-quiet);
    font-variant-numeric: tabular-nums;
  }
  .era-card .era-blurb {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  @media (min-width: 920px) {
    /* Hide the blurb in the 5-up desktop layout to keep cards compact. */
    .era-card .era-blurb { display: none; }
  }

  .sections-toggle {
    margin-top: 1rem;
    font-size: 0.88rem;
  }
  .sections-toggle summary {
    cursor: pointer;
    color: var(--ink-soft);
    padding: 0.4rem 0;
    user-select: none;
    list-style: none;
  }
  .sections-toggle summary::-webkit-details-marker { display: none; }
  .sections-toggle summary::before {
    content: "▸ ";
    color: var(--ink-quiet);
    font-size: 0.8em;
  }
  .sections-toggle[open] summary::before { content: "▾ "; }
  .sections-toggle summary:hover { color: var(--brass-deep); }
  .sections-list {
    list-style: none;
    padding: 0.5rem 0 0;
    margin: 0;
    display: grid;
    gap: 0.3rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 540px) {
    .sections-list { grid-template-columns: repeat(2, 1fr); }
  }
  .sections-list li { margin: 0; }
  .sections-list a {
    display: block;
    padding: 0.4rem 0.6rem;
    background: var(--surface);
    border: 1px solid var(--surface-line);
    border-radius: 2px;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.9rem;
  }
  .sections-list a:hover { border-color: var(--brass); }

  /* Body — visual rhythm for 99 events ------------------------------- */
  .history-body { margin-top: 2.5rem; }

  .history-body h2 {
    font-size: 1.55rem;
    margin: 3rem 0 1rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--surface-line);
    scroll-margin-top: clamp(1rem, 8vh, 4rem);
  }

  .history-body h3 {
    font-size: 1.1rem;
    margin: 2rem 0 0.5rem;
    padding-left: 0.85rem;
    border-left: 3px solid var(--brass);
    line-height: 1.3;
    scroll-margin-top: clamp(1rem, 8vh, 4rem);
  }

  /* Indent the immediate paragraph + bullet list under each h3 so the
   * brass border feels like a citation rule for the entry's body. */
  .history-body h3 + p,
  .history-body h3 + ul {
    margin-top: 0.4rem;
    padding-left: 0.95rem;
    border-left: 1px solid var(--surface-line);
  }

  .history-body h3 + ul {
    list-style: none;
    padding-left: 1.1rem;
  }
  .history-body h3 + ul li {
    position: relative;
    padding: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
    margin: 0.25rem 0;
  }
  .history-body h3 + ul li::before {
    content: "";
    position: absolute;
    left: -0.65rem;
    top: 0.7em;
    width: 0.35rem;
    height: 1px;
    background: var(--ink-quiet);
  }
  /* Strong labels at the start of bullet items (e.g. "**Introduced**:") */
  .history-body h3 + ul li strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* Anchor link affordance — when an h3 is the navigation target, hint
   * it visually so the user can confirm they jumped to the right entry. */
  .history-body h3:target {
    background: rgba(138, 106, 43, 0.07);
    border-left-color: var(--bridle);
    margin-left: -0.85rem;
    padding-left: 1.7rem;
  }

  .back-to-top {
    margin: 3rem 0 0;
    text-align: right;
    font-size: 0.85rem;
  }
  .back-to-top a {
    color: var(--ink-quiet);
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--surface-line);
    border-radius: 2px;
    display: inline-block;
  }
  .back-to-top a:hover {
    color: var(--brass-deep);
    border-color: var(--brass);
  }
</style>
