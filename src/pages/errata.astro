---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content, getHeadings } from '../../errata.md';

const base = import.meta.env.BASE_URL;
const headings = await getHeadings();

// Group h3 entries by year for a quick year-jump TOC. Each errata heading
// follows the convention `### YYYY-MM-DD — Title`. Headings that don't
// fit (Format, How to add a future erratum, etc.) get bucketed as
// "Other sections".
const events = headings.filter((h) => h.depth === 3);
const sections = headings.filter((h) => h.depth === 2);

const datedEvents = events.filter((h) => /^20\d{2}-\d{2}-\d{2}/.test(h.text));
const undatedEvents = events.filter((h) => !/^20\d{2}-\d{2}-\d{2}/.test(h.text));

// Bucket by year.
const byYear = {};
for (const h of datedEvents) {
  const m = h.text.match(/^(20\d{2})/);
  if (!m) continue;
  const year = m[1];
  (byYear[year] ??= []).push(h);
}
const years = Object.keys(byYear).sort().reverse();
---

<BaseLayout
  title="Errata"
  description="Dated corrections log for the coachbook archive."
>
  <article>
    <h1 id="top">Errata</h1>
    <p class="lede">
      Every correction to the archive is dated and logged. Trust comes
      from documenting being wrong; nothing is silently overwritten.
    </p>

    {datedEvents.length > 0 && (
      <nav class="errata-toc" aria-label="Errata navigation">
        <h2>Jump to year</h2>
        <ul class="year-grid">
          {years.map((year) => (
            <li>
              <a href={`#${byYear[year][0].slug}`}>
                <strong>{year}</strong>
                <span class="card-meta">
                  {byYear[year].length} {byYear[year].length === 1 ? 'entry' : 'entries'}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="errata-body">
      <Content />
    </div>

    <p class="back-to-top"><a href="#top">↑ Back to top</a></p>
  </article>
</BaseLayout>

<style is:global>
  .errata-toc {
    margin: 1.5rem 0 2.5rem;
  }
  .errata-toc h2 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin: 0 0 0.75rem;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
  }
  .year-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8em, 1fr));
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .year-grid li { margin: 0; display: flex; }
  .year-grid a {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0.85rem 0.95rem;
    background: var(--surface);
    border: 1px solid var(--surface-line);
    border-radius: 3px;
    text-decoration: none;
    color: var(--ink);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .year-grid a:hover { border-color: var(--brass); background: var(--paper-soft); }
  .year-grid a strong {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .errata-body {
    margin-top: 2.5rem;
  }
  .errata-body h2 {
    font-size: 1.55rem;
    margin: 3rem 0 1rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--surface-line);
    scroll-margin-top: clamp(1rem, 8vh, 4rem);
  }
  .errata-body h3 {
    font-size: 1.05rem;
    margin: 2rem 0 0.5rem;
    padding-left: 0.85rem;
    border-left: 3px solid var(--brass);
    line-height: 1.3;
    scroll-margin-top: clamp(1rem, 8vh, 4rem);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .errata-body h3 + ul,
  .errata-body h3 + p {
    margin-top: 0.4rem;
    padding-left: 0.95rem;
    border-left: 1px solid var(--surface-line);
  }
  .errata-body h3:target {
    background: rgba(138, 106, 43, 0.07);
    border-left-color: var(--bridle);
    margin-left: -0.85rem;
    padding-left: 1.7rem;
  }
</style>
