---
// Breadcrumbs — small horizontal trail above the page H1.
// Last crumb is the current page (no link, marked aria-current="page").
//
// Usage:
//   <Breadcrumbs trail={[
//     { label: 'Models', href: '/coachbook/models/' },
//     { label: 'Willis 9927' },
//   ]} />

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  trail: Crumb[];
}

const { trail } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = { label: 'Home', href: base };
const items = [home, ...trail];
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) => {
      const isLast = i === items.length - 1;
      return (
        <li>
          {c.href && !isLast ? (
            <a href={c.href}>{c.label}</a>
          ) : (
            <span aria-current={isLast ? 'page' : undefined}>{c.label}</span>
          )}
          {!isLast && <span class="sep" aria-hidden="true">/</span>}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    color: var(--ink-quiet);
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .breadcrumbs a { color: var(--ink-soft); }
  .breadcrumbs [aria-current="page"] {
    color: var(--ink);
    font-weight: 500;
  }
  .breadcrumbs .sep { color: var(--ink-quiet); }
</style>
